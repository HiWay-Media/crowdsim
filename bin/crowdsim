#!/usr/bin/env bash
#
# crowdsim — replay a live-event traffic mix against a web frontend, and measure what caching buys you.
#
# WHY IT EXISTS — when an SSR frontend collapses under a traffic spike you usually end up with two
#   numbers reconstructed from logs after the fact: "the app tier saturates around N req/s" and "a shared
#   micro-cache would cut origin load by X". Both are guesses until you can produce them on demand.
#   crowdsim climbs in steps until the knee, brakes as soon as it is crossed, and its `cache-ab` mode
#   measures the real offload factor of a candidate cache config instead of simulating it.
#
# ⚠️ THIS TOOL GENERATES REAL LOAD ON WHATEVER YOU POINT IT AT. If you point it at production you will
#   serve errors to real users, and to every co-tenant sharing that infrastructure. Hence the gates:
#   the target host must match an explicit allowlist, and going past the safe peak needs
#   --i-know-this-breaks-production. There is no interactive "are you sure" fallback, on purpose:
#   this runs unattended in CI and on schedulers, where a prompt would either hang or be auto-answered.
#
# SUBCOMMANDS
#   doctor      check the prerequisites on this machine and say what is missing (run this first)
#   discover    fetch the sitemap and extract a pool of REAL URLs (404s do not load the app tier:
#               testing non-existent URLs yields a false "it handles this beautifully")
#   probe       preflight: reachability, a verdict per declared cache layer, weight of one page,
#               and — for every authed class — whether its endpoint really requires the token
#   load        the load test
#   cache-ab    A/B a candidate cache config: two local nginx legs against the same origin, one with
#               the tweak under evaluation and one as-is → measured hit ratio and offload
#   history     one line per run, to see whether the knee moves over time
#   compare     the delta between two runs, and a refusal when they are not comparable
#   report      one run as pasteable markdown, with the caveats that do not survive retyping · --html
#               draws it instead: the ramp as a curve, the knee, per class, in one offline file
#   weights     count YOUR access log into the class mix: the one input this tool demands and used to
#               refuse to help measure. Reads a file or stdin, writes nothing (needs node)
#   init        draft a first profile from what probe/discover/record already measured (safety left blank)
#   record      turn a browser HAR export into a journey file for --shape journey (needs node)
#   validate    check a profile against every rule at once, without generating anything (needs node)
#   serve       the GUI: same gates, same output directory, on http://127.0.0.1:8787 (needs node)
#
# Usage:
#   crowdsim doctor
#   crowdsim discover --profile <f.json> [--limit 400] [--verify]
#   crowdsim probe    --profile <f.json> [--target <name>]
#   crowdsim load     --profile <f.json> [--target <name>] [--shape mix|journey]
#                     [--peak 120] [--start 30] [--steps 4] [--step-dur 60s] [--hold 120s]
#                     [--rsc-mode repeat|random] [--max-5xx 0.05] [--max-p95 5000]
#                     [--safe-peak 150] [--i-know-this-breaks-production] [--touch-and-go] [--dry-run]
#                     [--warmup 30s] [--warmup-peak 20]
#   crowdsim cache-ab --profile <f.json> [--peak 60] [--ttl 10] [--third <t.conf>] [--run] | --new-leg <t.conf>
#   crowdsim weights  [<access.log>] --profile <f.json> [--format "time method path status"]
#                     [--top 10] [--json]     ·  or:  … | crowdsim weights - --profile <f.json>
#   crowdsim compare  <run-a> <run-b> [--json]
#   crowdsim init     [--out <profile.json>] [--access-log <access.log>]
#   crowdsim report   <run-id> [--compare <run-id>] [--out <file.md>]
#                     [--html]   the same run as a self-contained page with charts (needs node)
#   crowdsim record   <file.har> [--out <journey.json>] [--origin <url>] [--rsc-query _rsc] [--force]
#   crowdsim validate <f.json>
#   crowdsim serve    [--port 8787] [--bind 127.0.0.1]
#
# Environment:
#   CROWDSIM_ALLOW_TARGETS   comma-separated host globs the tool is allowed to hit. REQUIRED unless the
#                            profile declares safety.allow_hosts. No default, by design.
#   CROWDSIM_AUTH_USERS      path to a `username,password` CSV used by the login/authed classes. Keep it
#                            OUT of the profile: profiles get shared, credentials should not travel with
#                            them. In the container the file must be mounted and the path is the one
#                            inside the container.
#   CROWDSIM_OUT             output directory for logs and summaries (default: ./out)
#   CROWDSIM_SLACK_WEBHOOK   if set, --slack posts the run recap there. Never hardcode a webhook here.
#   CROWDSIM_PROFILES        profile dir the GUI reads/writes (default: ./profiles) · CROWDSIM_GUI_TOKEN:
#                            bearer token for the GUI; REQUIRED to bind anything but loopback
#   CROWDSIM_ROOT            where k6/, gui/ and cache-ab/ live (default: the parent of this script)
#
# Exit: 0 = executed (a run stopped by the brake is an OUTCOME, not an error) · 2 = usage
#       3 = safety gate · 4 = target unreachable · 5 = k6 missing
# Requires: k6, curl, python3 (and node for `validate`, `record`, `weights` and `serve`).
#
#@@ ─── per-subcommand help ────────────────────────────────────────────────────────────────────────
# `crowdsim --help` stops at the line above; `crowdsim <subcommand> --help` prints one block below.
# One source, two views: a second copy of a flag list is a copy that disagrees with the driver by the
# next release. tests/cli/help.bats asserts that every flag the parser accepts appears in at least one
# block, so a new flag that is never documented fails the suite — and completions/ reads these same
# blocks at completion time rather than carrying a copy of the list.
#
#@ doctor
#   crowdsim doctor [--profile <f.json>] [--bench]
#
#   What is missing on this machine, and (with --profile) what is wrong with that profile. A report,
#   never a gate: it exits 0 even when things are missing, because deciding is yours.
#
#     --profile <f.json>   also run the structural profile checks (pools, references, empty pools)
#     --bench              measure what THIS machine can generate, against a local server on loopback.
#                          Needs node. A generator that cannot hold the rate makes every number a
#                          property of the generator; this is how you find that out beforehand.
#
#   Example:
#     crowdsim doctor --profile profiles/example.json
#
#@ discover
#   crowdsim discover --profile <f.json> [--target <name>] [--limit 400] [--verify]
#
#   Fetch the sitemap and write a pool of REAL URLs. 404s do not load the app tier, so a pool of
#   invented paths yields a false "it handles this beautifully".
#
#     --profile <f.json>   the profile whose target and pool paths are used  (required)
#     --target <name>      a named target from the profile (default: targets.default)
#     --limit <n>          maximum URLs in the pool (default: 400)
#     --verify             request each path and keep only those answering 2xx. Sequential, paced by
#                          CROWDSIM_VERIFY_DELAY: discovery must not become the load test.
#
#   Example:
#     crowdsim discover --profile profiles/example.json --limit 400 --verify
#
#@ probe
#   crowdsim probe --profile <f.json> [--target <name>] [--insecure]
#
#   Preflight one target: status, TTFB, page weight, a verdict per declared cache layer, and — for
#   every `authed` class — one request sent WITHOUT the token, to check that the endpoint really
#   requires it. Writes out/probe-<run>.log and out/probe-<run>.json.
#
#     --profile <f.json>   the profile to preflight  (required)
#     --target <name>      a named target from the profile (default: targets.default)
#     --insecure           skip TLS verification, for a node addressed by IP
#
#   Exits 4 if the target answers >=400, or if an authed class turns out not to need its token.
#
#   Example:
#     crowdsim probe --profile profiles/example.json --target edge
#
#@ load
#   crowdsim load --profile <f.json> [--target <name>] [flags]
#
#   The load test. Climbs in steps to --peak, holds, and brakes as soon as the SLO is crossed.
#   Exits 0 whenever it executed — INCLUDING when the brake tripped, because finding the knee is
#   the point. Writes out/summary-<run>.json, out/load-<run>.log, and appends to out/history.tsv.
#
#     --profile <f.json>   the profile  (required)
#     --target <name>      a named target from the profile (default: targets.default)
#     --base-url <url>     bypass target resolution. Still subject to the allowlist.
#     --shape mix|journey  mix = one scenario per class; journey = sessions from a journey file
#     --peak <n>           total requests/s at peak, split across classes by weight (default: 60)
#     --start <n>          rate of the first step (default: 15)
#     --steps <n>          linear steps from start to peak (default: 4)
#     --step-dur <dur>     duration of each step (default: 60s)
#     --hold <dur>         time held at peak; 0s means climb and leave (default: 120s)
#     --rsc-mode repeat|random   repeat replays the few distinct navigation URLs a real build
#                          produces; random measures the opposite hypothesis (default: repeat)
#     --max-p95 <ms>       brake: abort when the brake class's p95 crosses this
#     --max-5xx <ratio>    brake: abort when the failed rate crosses this
#     --abort-delay <dur>  grace period before the brake is evaluated (default: 30s)
#     --safe-peak <n>      the ceiling for this run
#     --i-know-this-breaks-production   the ONLY way past the safe peak. Command line, every time.
#     --warmup <dur>       an unmeasured run first: fills caches, opens pools, JITs the app. Its
#                          numbers go to warmup-<run>.json and are NOT mixed into the result.
#     --warmup-peak <n>    rate for the warm-up (default: --start)
#     --touch-and-go       preset: --steps 3 --step-dur 20s --hold 0s --abort-delay 10s. The cheapest
#                          ramp that still produces errors — NOT a way to make a test harmless.
#     --skip-classes <a,b> classes to leave out (routes this tier does not serve)
#     --insecure           skip TLS verification, for a node addressed by IP
#     --slack              post a recap to CROWDSIM_SLACK_WEBHOOK
#     --dry-run            print the exact k6 invocation and stop. Sends nothing.
#
#   Example:
#     CROWDSIM_ALLOW_TARGETS='www.example.test' \
#       crowdsim load --profile profiles/example.json --peak 60 --warmup 30s
#
#@ cache-ab
#   crowdsim cache-ab --profile <f.json> [--peak 60] [--ttl 10] [--third <t.conf>] [--run]
#   crowdsim cache-ab --new-leg <t.conf>
#
#   A/B a candidate cache config: local nginx legs against the same origin, one with the tweak and
#   one as-is, so the offload factor is measured instead of argued about.
#
#     --profile <f.json>   the profile the legs are loaded with  (required, except with --new-leg)
#     --target <name>      a named target from the profile, used as the origin
#     --base-url <url>     origin URL, bypassing target resolution
#     --peak <n>           requests/s each leg is loaded at (default: 60)
#     --ttl <s>            cache TTL for the candidate leg (default: 10)
#     --third <t.conf>     a third leg from your own template, alongside asis and candidate
#     --new-leg <t.conf>   scaffold a leg template and exit. Carries the warning it must carry.
#     --run                load every leg in turn and compare them. Sequential on purpose: two
#                          generators on one host measure the host.
#
#   Example:
#     crowdsim cache-ab --new-leg legs/narrow-fix.conf.template
#     crowdsim cache-ab --profile profiles/example.json --third legs/narrow-fix.conf.template
#
#@ history
#   crowdsim history
#
#   One line per run from out/history.tsv, so the knee can be watched over time rather than
#   reconstructed. Reads the file the driver writes; it never re-runs anything.
#
#   Example:
#     crowdsim history
#
#@ compare
#   crowdsim compare <run-a> <run-b> [--json]
#
#   The delta between two runs — and a refusal when they are not comparable. Two runs with different
#   pools, profiles, or a generator that did not hold the rate produce a difference that is about the
#   measurement, not about the system.
#
#     --json   machine-readable output
#
#   Example:
#     crowdsim compare 20260901T101500Z 20260901T121500Z
#
#@ report
#   crowdsim report <run-id> [--compare <run-id>] [--out <file.md>] [--html]
#
#   One run as pasteable markdown, with the caveats that do not survive retyping — or, with --html,
#   the same run drawn: the ramp as a curve, the knee band, p95 per class against that class's own
#   limit, cache per layer. One self-contained file, no external resources and no scripts.
#
#     --compare <run-id>   include the delta against another run, with the same refusals as `compare`
#     --out <file.md>      write to a file instead of stdout
#     --html               the page instead of the markdown. Needs node.
#
#   A run with generator_ok: false or an unreachable target gets no latency charts at all — only the
#   part that shows why it is invalid.
#
#   Example:
#     crowdsim report 20260901T121500Z --out ticket.md
#     crowdsim report 20260901T121500Z --html
#
#@ weights
#   crowdsim weights [<access.log>] --profile <f.json> [--format "time method path status"]
#                    [--top 10] [--json]
#   … | crowdsim weights - --profile <f.json>
#
#   Count YOUR access log into the class mix — the one input this tool demands and used to refuse to
#   help measure. Needs node. Reads a file or stdin; writes nothing, anywhere: the log is handed
#   over, never fetched, and nothing from it lands in out/.
#
#     --profile <f.json>   the profile whose classes define what to count  (required)
#     --format <fields>    columns of a log that is not the combined format: request, path, method,
#                          status, time, -
#     --top <n>            how many unclassified paths to show (default: 10)
#     --json               counts, shares and the window — never a path from the log
#
#   Example:
#     crowdsim weights /var/log/nginx/access.log --profile profiles/example.json
#     ssh host 'cat /var/log/nginx/access.log' | crowdsim weights - --profile profiles/example.json
#
#@ init
#   crowdsim init [--out <profile.json>] [--access-log <access.log>]
#
#   Draft a first profile from what probe, discover and record have already measured, saying which
#   run each part came from. The two safety keys are left EMPTY on purpose: an allowlist and a safe
#   peak are decisions, and no tool gets to make them for you.
#
#     --out <profile.json>   where to write the draft (default: ./profile.json)
#     --access-log <file>    measure the class weights from this log instead of writing them as TODO
#
#   Example:
#     crowdsim init --out my-site.json --access-log /var/log/nginx/access.log
#
#@ record
#   crowdsim record <file.har> [--out <journey.json>] [--origin <url>] [--rsc-query _rsc] [--force]
#
#   Turn a browser HAR export into a journey file for --shape journey. Needs node.
#
#     --out <journey.json>   where to write it (default: alongside the HAR)
#     --origin <url>         keep only requests to this origin
#     --rsc-query <name>     the query parameter that marks a navigation request (default: _rsc)
#     --force                overwrite an existing journey file
#
#   Example:
#     crowdsim record session.har --out journeys/browse.json --origin https://www.example.test
#
#@ validate
#   crowdsim validate <f.json>
#
#   Every rule at once, before anything runs: structure, pool references, class kinds, the auth
#   block, the brake class, the SLO. Needs node. Generates nothing. Exits 2 on a bad profile.
#
#   Without node, `crowdsim doctor --profile <f>` still does the structural checks and says which
#   ones did not run — rather than printing nothing and letting you believe it passed.
#
#   Example:
#     crowdsim validate profiles/example.json
#
#@ serve
#   crowdsim serve [--port 8787] [--bind 127.0.0.1]
#
#   The GUI. Needs node. Every run is a child process of this same driver, so both gates and every
#   exit code are exactly the ones above — the page re-implements none of it.
#
#     --port <n>      port (default: 8787)
#     --bind <addr>   bind address (default: 127.0.0.1). Anything but loopback REQUIRES
#                     CROWDSIM_GUI_TOKEN: a page that can generate 500 req/s at your production has
#                     no business on a shared network.
#
#   Example:
#     crowdsim serve --port 8787
#

set -eo pipefail
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# CROWDSIM_ROOT exists for the container image, where the script lives in /usr/local/bin and the rest of
# the tool (k6/, gui/, cache-ab/) lives in /crowdsim: deriving the root from the script's own path would
# resolve to /usr/local and quietly break `serve` and `cache-ab`.
ROOT="${CROWDSIM_ROOT:-$(cd "$SELF_DIR/.." && pwd)}"
K6_SCRIPT="${CROWDSIM_K6_SCRIPT:-$ROOT/k6/live-event.js}"
OUT_DIR="${CROWDSIM_OUT:-$PWD/out}"

PROFILE_F=""; TARGET=""; SHAPE="mix"; PEAK=60; START=15; STEPS=4; STEP_DUR="60s"; HOLD="120s"
RSC_MODE="repeat"; MAX_5XX=""; MAX_P95=""; SAFE_PEAK=""; ABORT_DELAY="30s"; TOUCH_AND_GO=0
BASE_URL_OVERRIDE=""; SLACK=0; DRY=0; FORCE=0; LIMIT=400; TTL=10; INSECURE=0; SKIP_CLASSES=""
VERIFY=0
POSITIONAL=()
GUI_PORT=""; GUI_BIND=""

# The comment header IS the help text: it cannot drift from the script, which is why it is written for a
# reader and not for a parser. Extracted by structure — from line 2 (the shebang is not documentation) up
# to the first line that is not a comment — and not by a line count: the previous version read lines 1-60
# and so printed `!/usr/bin/env bash` as the first line of `crowdsim --help`, and silently truncated the
# help the moment the header grew past sixty lines.
usage() { sed -n '2,${/^#/!q; /^#@/q; s/^# \{0,1\}//p;}' "$0" | sed '/./,$!d'; }

# `crowdsim <subcommand> --help`. The per-subcommand text lives in the SAME header the global help comes
# from, in `#@ <name>` blocks below the `#@@` marker that stops usage(). Two sources would disagree once,
# and a help page that contradicts the tool is worse than a long one.
#
# Returns 1 when the subcommand has no block, so the caller falls back to the global help rather than
# printing nothing — an empty --help is indistinguishable from a broken one.
subcommand_usage() {
  local found
  found="$(awk -v want="$1" '
    $0 == "#@ " want { inblock = 1; next }
    /^#@/ && inblock  { exit }
    inblock && /^#/   { sub(/^# ?/, ""); print; next }
    inblock           { exit }
  ' "$0")"
  [ -n "$found" ] || return 1
  printf '%s\n' "$found"
  printf '%s\n' "Every flag, every exit code and the environment: crowdsim --help"
}
say()   { printf '%s\n' "$*"; }
ok()    { printf '  ✅ %s\n' "$*"; }
warn()  { printf '  ⚠️  %s\n' "$*"; }
# note: "$1" and not "$*" — the second argument is the exit code, not part of the message
die()   { printf '❌ %s\n' "$1" >&2; exit "${2:-1}"; }

# Which version is this? The question gets asked in the middle of something going wrong, and until now the
# CLI could not answer it at all — while inside the image the GUI could not either, because it reads a
# package.json the image does not contain. Three sources, in the order of how much they can be trusted:
# what the build baked in, what this checkout says, and an honest "unknown".
crowdsim_version() {
  if [ -n "${CROWDSIM_VERSION:-}" ]; then printf '%s' "$CROWDSIM_VERSION"; return 0; fi
  if [ -f "$ROOT/package.json" ]; then
    python3 -c 'import json,sys
try:
    print(json.load(open(sys.argv[1]))["version"])
except Exception:
    print("unknown")' "$ROOT/package.json" 2>/dev/null && return 0
  fi
  printf '%s' "unknown"
}

CMD="${1:-}"; shift || true
# `--help` in SUBCOMMAND position: without this case it falls through to the unknown-subcommand branch
# and exits 2 — which is the first thing anyone tries. `--version` is the second.
case "$CMD" in
  -h|--help) usage; exit 0;;
  -V|--version)
    v="$(crowdsim_version)"
    if [ "$v" = "unknown" ]; then
      say "crowdsim unknown (not packaged: no CROWDSIM_VERSION baked in and no package.json at $ROOT)"
    else
      say "crowdsim $v"
    fi
    exit 0;;
  "") usage; exit 2;;
esac

while [ $# -gt 0 ]; do
  case "$1" in
    --profile) PROFILE_F="$2"; shift 2;;
    --target) TARGET="$2"; shift 2;;
    --shape) SHAPE="$2"; shift 2;;
    --peak) PEAK="$2"; shift 2;;
    --start) START="$2"; shift 2;;
    --steps) STEPS="$2"; shift 2;;
    --step-dur) STEP_DUR="$2"; shift 2;;
    --hold) HOLD="$2"; shift 2;;
    --rsc-mode) RSC_MODE="$2"; shift 2;;
    --max-5xx) MAX_5XX="$2"; shift 2;;
    --max-p95) MAX_P95="$2"; shift 2;;
    --safe-peak) SAFE_PEAK="$2"; shift 2;;
    --skip-classes) SKIP_CLASSES="$2"; shift 2;;
    --base-url) BASE_URL_OVERRIDE="$2"; shift 2;;
    --limit) LIMIT="$2"; shift 2;;
    --ttl) TTL="$2"; shift 2;;
    --abort-delay) ABORT_DELAY="$2"; shift 2;;
    --port) GUI_PORT="$2"; shift 2;;
    --bind) GUI_BIND="$2"; shift 2;;
    --json) COMPARE_JSON=1; WEIGHTS_JSON=1; shift;;
    --bench) BENCH=1; shift;;
    --run) RUN_LEGS=1; shift;;
    --warmup) WARMUP_DUR="$2"; shift 2;;
    --compare) REPORT_COMPARE="$2"; shift 2;;
    --warmup-peak) WARMUP_PEAK="$2"; shift 2;;
    --third) THIRD_LEG="$2"; shift 2;;
    --new-leg) NEW_LEG="$2"; shift 2;;
    --out) JOURNEY_OUT="$2"; REPORT_OUT="$2"; INIT_OUT="$2"; shift 2;;
    --origin) RECORD_ORIGIN="$2"; shift 2;;
    --format) LOG_FORMAT="$2"; shift 2;;
    --top) LOG_TOP="$2"; shift 2;;
    --access-log) ACCESS_LOG="$2"; shift 2;;
    --rsc-query) RSC_QUERY_OVERRIDE="$2"; shift 2;;
    --force) FORCE_OVERWRITE=1; shift;;
    --verify) VERIFY=1; shift;;
    --html) REPORT_HTML=1; shift;;
    --touch-and-go) TOUCH_AND_GO=1; shift;;
    --insecure) INSECURE=1; shift;;
    --slack) SLACK=1; shift;;
    --dry-run) DRY=1; shift;;
    --i-know-this-breaks-production) FORCE=1; shift;;
    # A subcommand answers for itself when it can. `load` alone has twenty flags, and finding them used
    # to mean reading the synopsis of twelve other subcommands first.
    -h|--help) if [ -n "$CMD" ] && subcommand_usage "$CMD"; then exit 0; fi; usage; exit 0;;
    # A single `-` is the conventional name for stdin, and `weights` is the one subcommand whose input
    # normally arrives that way: an access log usually cannot be copied off the host that holds it.
    -) if [ "$CMD" = "weights" ]; then POSITIONAL+=("-"); shift; else die "unknown option: -" 2; fi;;
    # `crowdsim validate my-site.json` reads better than requiring --profile for a command whose only
    # argument IS the profile, and the same goes for the two run ids `compare` works on. Everywhere else a
    # bare word is still a mistake worth stopping for.
    *) if [ "$CMD" = "validate" ] && [ -z "$PROFILE_F" ]; then PROFILE_F="$1"; shift
       elif [ "$CMD" = "compare" ] || [ "$CMD" = "record" ] || [ "$CMD" = "report" ] \
            || [ "$CMD" = "init" ] || [ "$CMD" = "weights" ]; then POSITIONAL+=("$1"); shift
       else die "unknown option: $1" 2; fi;;
  esac
done

if [ "$TOUCH_AND_GO" = "1" ]; then
  # ⚠️ "just a few seconds" does not produce 504s: a 504 needs a QUEUE, and a queue needs time to build.
  #   This preset is the cheapest thing that still produces errors: steep ramp, no hold, brake reacting
  #   in 10s instead of 30. Expect ~20-40s of errors, not 5.
  STEPS=3; STEP_DUR="20s"; HOLD="0s"; ABORT_DELAY="10s"
fi

RUN_ID="$(date -u +%Y%m%dT%H%M%SZ)"
mkdir -p "$OUT_DIR"
HISTORY_F="$OUT_DIR/history.tsv"

# ─────────────────────────────── profile handling ───────────────────────────────────────────────────
# The profile is the only place a real hostname, URL pool or measured mix ever lives. This repo ships
# profiles/example.json and nothing else: keep your own profiles in your own private repo.
need_profile() {
  if [ -z "$PROFILE_F" ]; then die "--profile <file.json> is required (see profiles/example.json)" 2; fi
  if [ ! -f "$PROFILE_F" ]; then die "profile not found: $PROFILE_F" 2; fi
}

# Resolves "@relative/file.json" pool references into inlined arrays and writes the result to
# $RESOLVED. k6 can only open() files in the init context, so one self-contained file keeps it simple.
RESOLVED=""
resolve_profile() {
  need_profile
  RESOLVED="$OUT_DIR/profile-$RUN_ID.json"
  python3 - "$PROFILE_F" "$RESOLVED" <<'PY'
import json, os, sys
src, dst = sys.argv[1], sys.argv[2]
base = os.path.dirname(os.path.abspath(src))
with open(src) as f: p = json.load(f)
# keys starting with "_" are documentation: JSON has no comments, and a profile that cannot explain
# itself gets copied wrong. They are stripped here so they never reach the generator as data.
pools = {k: v for k, v in (p.get('pools') or {}).items() if not k.startswith('_')}
for k, v in list(pools.items()):
    if isinstance(v, str) and v.startswith('@'):
        path = os.path.join(base, v[1:])
        if not os.path.exists(path):
            sys.exit(f"pool '{k}' points at a missing file: {path}")
        with open(path) as f: pools[k] = json.load(f)
    if not isinstance(pools[k], list):
        sys.exit(f"pool '{k}' must be a list of paths (or '@file.json')")
p['pools'] = pools

classes, dropped = [], []
for c in p.get('classes', []):
    for key in ('pool', 'path_suffix_pool'):
        ref = c.get(key)
        if ref and ref not in pools:
            sys.exit(f"class '{c.get('name')}' references unknown pool '{ref}'")
    # An empty pool has NO honest fallback. Sending the class at some other pool would silently
    # measure the wrong request type under the right label — e.g. a rendered 404 counted as a static
    # asset. Dropping the class and saying so is the only non-misleading option; the remaining
    # weights are then renormalised, so --peak still means what you asked for.
    if c.get('pool') and not pools.get(c['pool']):
        dropped.append(f"{c.get('name')} (pool '{c['pool']}' is empty)")
        continue
    classes.append(c)
if not classes:
    sys.exit('every class was dropped for want of a non-empty pool')
p['classes'] = classes
with open(dst, 'w') as f: json.dump(p, f)
for d in dropped:
    print(f"  ⚠️  class skipped: {d} — the mix is renormalised over the rest", file=sys.stderr)
PY
}

# ─────────────────────────────── profile validation (shared with the GUI) ───────────────────────────
# The rules live once, in lib/validate.js, and the GUI's editor applies exactly these. Reaching them from
# bash means node, which the CLI otherwise does not need — so its absence is stated rather than hidden, and
# what remains is the structural checking resolve_profile does anyway (pool references, missing pool files,
# empty pools). Two rule sets would drift, and the day they drift the one that matters is whichever the
# operator did not run.
#   $1 = gate    errors abort the command (exit 2)
#   $1 = report  errors are printed, the command carries on (doctor is a report, not a gate)
VALIDATOR="$ROOT/lib/validate-cli.mjs"
validate_profile() {
  local mode="$1" out rc=0
  if ! command -v node >/dev/null 2>&1 || [ ! -f "$VALIDATOR" ]; then
    warn "full profile validation needs node — only the structural checks ran (see docs/profile.md)"
    return 0
  fi
  out="$(node "$VALIDATOR" "$PROFILE_F" --brief 2>&1)" || rc=$?
  if [ -n "$out" ]; then printf '%s\n' "$out"; fi
  # 2 is the validator's own verdict: this profile has errors. ANY other non-zero code means the validator
  # did not get as far as an opinion — it crashed. Those two were reported identically until 1.20.1, and the
  # difference matters: one is your profile, the other is the installation. In the published image the
  # validator crashed on every profile (a missing package.json made an ES module read as CommonJS) and the
  # driver said "the profile has errors" about a profile that was fine, at exit 2 — so `load` never reached
  # the allowlist gate and refused for the wrong reason, with the wrong code.
  if [ "$rc" != "0" ] && [ "$rc" != "2" ]; then
    die "the profile validator itself failed (node exited $rc), so nothing about this profile has been
  checked. That is a broken installation, not a bad profile — the output above is node's, not ours.

  Try it directly:  node $VALIDATOR $PROFILE_F
  In a container, this is what a missing /crowdsim/package.json looks like: every .js under k6/ and lib/
  is then read as CommonJS and an ES import fails. Upgrade the image, or report it." 5
  fi
  if [ "$rc" != "0" ] && [ "$mode" = "gate" ]; then
    die "the profile has errors: fix them, or run 'crowdsim validate $PROFILE_F' for the full report" 2
  fi
  return 0
}

cmd_validate() {
  need_profile
  if ! command -v node >/dev/null 2>&1; then
    die "crowdsim validate needs node (18+). Without it, 'crowdsim doctor --profile <f>' still does the
  structural checks: pool references, missing pool files, empty pools." 5
  fi
  say "▶ validating $PROFILE_F"
  exec node "$VALIDATOR" "$PROFILE_F"
}

# jq is deliberately not a dependency: python3 is already required and is present on every host that
# runs a scheduler agent, whereas jq often is not.
pf() { python3 -c '
import json,sys
d=json.load(open(sys.argv[1]))
for k in sys.argv[2].split("."):
    if d is None: break
    d = d.get(k) if isinstance(d, dict) else None
print("" if d is None else (json.dumps(d) if isinstance(d,(dict,list)) else d))' "$PROFILE_F" "$1"; }

# ─────────────────────────────── target resolution ──────────────────────────────────────────────────
# A profile declares named targets. `bypass` lets you skip a CDN while keeping SNI and Host correct,
# which is how you measure your own origin instead of someone else's edge cache.
BASE_URL=""; HOST_HEADER=""; BYPASS=""
resolve_target() {
  if [ -n "$BASE_URL_OVERRIDE" ]; then
    BASE_URL="$BASE_URL_OVERRIDE"
    return 0
  fi
  local name="${TARGET:-$(pf targets.default)}"
  if [ -z "$name" ]; then die "no --target given and the profile has no targets.default" 2; fi
  local spec
  spec="$(python3 -c '
import json,sys
d=json.load(open(sys.argv[1]))
t=(d.get("targets") or {}).get("list") or {}
if sys.argv[2] not in t: sys.exit("unknown target: "+sys.argv[2]+" (have: "+", ".join(t)+")")
t=t[sys.argv[2]]
print(t.get("base_url",""));print(t.get("host_header",""));print(t.get("bypass",""))
print(t.get("skip_classes",""));print("1" if t.get("insecure") else "")' "$PROFILE_F" "$name")" || die "$spec" 2
  BASE_URL="$(printf '%s' "$spec"  | sed -n 1p)"
  HOST_HEADER="$(printf '%s' "$spec" | sed -n 2p)"
  BYPASS="$(printf '%s' "$spec"    | sed -n 3p)"
  local sk; sk="$(printf '%s' "$spec" | sed -n 4p)"
  if [ -z "$SKIP_CLASSES" ] && [ -n "$sk" ]; then SKIP_CLASSES="$sk"; fi
  # A target reached by address rather than by name (a single proxy node, an app instance) presents a
  # certificate for a name it is not being called by. Declaring that once in the profile beats
  # remembering --insecure on every run against that target — and forgetting it looks like an outage.
  if [ "$(printf '%s' "$spec" | sed -n 5p)" = "1" ]; then INSECURE=1; fi
  if [ -z "$BASE_URL" ]; then die "target '$name' has no base_url" 2; fi
  say "  target '$name' → $BASE_URL${HOST_HEADER:+  Host: $HOST_HEADER}${BYPASS:+  bypass: $BYPASS}"
}

# ─────────────────────────────── safety gates ───────────────────────────────────────────────────────
# Gate 1: the host must be explicitly allowlisted. This is what stops a copy-pasted command, a stale
# --base-url or a mis-set Nomad meta from firing at something that is not yours to load-test.
gate_allowlist() {
  local host allow
  host="$(printf '%s' "$BASE_URL" | sed -E 's#^[a-z]+://##; s#[:/].*$##')"
  allow="${CROWDSIM_ALLOW_TARGETS:-$(pf safety.allow_hosts | tr -d '[]"' | tr -d ' ')}"
  if [ -z "$allow" ]; then
    die "no target allowlist: set CROWDSIM_ALLOW_TARGETS=host1,host2 or safety.allow_hosts in the profile

  crowdsim refuses to generate load against a host nobody explicitly authorised. This is not a
  formality: a load test aimed at the wrong hostname is indistinguishable from an attack." 3
  fi
  local m=0 pat
  IFS=',' read -r -a _pats <<< "$allow"
  for pat in "${_pats[@]}"; do
    case "$host" in $pat) m=1;; esac
  done
  if [ "$m" != "1" ]; then
    die "host '$host' is not in the allowlist ($allow)" 3
  fi
  ok "allowlist: '$host' authorised"
}

# Gate 2: past the safe peak you are knowingly aiming at the knee, which means real errors for real
# users. It must be stated on the command line every single time — never remembered in a config.
gate_peak() {
  local safe="${SAFE_PEAK:-$(pf safety.safe_peak_rps)}"
  safe="${safe:-150}"
  if [ "$PEAK" -le "$safe" ] 2>/dev/null; then
    ok "peak ${PEAK} req/s is within the safe ceiling (${safe})"
    return 0
  fi
  if [ "$FORCE" != "1" ]; then
    die "peak ${PEAK} req/s is above the safe ceiling (${safe} req/s)

  Past this point the test is expected to produce 5xx for real users of $BASE_URL, and to degrade
  any co-tenant sharing the same nodes. If that is the intent, say so explicitly:

      --i-know-this-breaks-production

  Before you do: agree a window, warn whoever watches the uptime alerts, and be ready to stop." 3
  fi
  warn "peak ${PEAK} req/s is ABOVE the safe ceiling (${safe}) and the override is set — this will hurt"
}

# ─────────────────────────────── doctor ─────────────────────────────────────────────────────────────
K6=""
k6_bin() {
  if command -v k6 >/dev/null 2>&1; then K6="k6"; return 0; fi
  die "k6 not found.

  Install it natively — do NOT run the generator through Docker on a laptop: on macOS and Windows the
  Docker network layer becomes the bottleneck before the target does, iterations get dropped, and the
  run is invalid (crowdsim will tell you, but you will have wasted the window).

    macOS:  brew install k6
    Linux:  https://grafana.com/docs/k6/latest/set-up/install-k6/

  Inside a Linux container on a host near the target, Docker is fine — that is what the shipped image
  and the Nomad job are for." 5
}

# ─────────────────────────────── bench: what can THIS machine generate? ─────────────────────────────
# `safety.generator_mbps` is the number the "you will get generator_ok: false" warning rests on, and it is
# typed into a profile by hand — usually once, usually copied to the next profile. So the check that exists
# to stop you burning a window on an unmeasurable run depends on a guess about a laptop.
#
# The machine can answer this itself, and without touching anybody's target: a throwaway HTTP server on
# loopback, k6 against it in a closed model, and the result written where the estimate can read it.
#
# The number is an UPPER BOUND, and the artefact says so in its own body. Loopback is the best network this
# generator will ever see; the path to a real target is narrower, always. A declared generator_mbps still
# wins, because somebody who knows the uplink is 100 Mbit/s is right and this measurement is not.
BENCH_PAGE_BYTES="${CROWDSIM_BENCH_BYTES:-46000}"
BENCH_DUR="${CROWDSIM_BENCH_DUR:-10s}"
BENCH_VUS="${CROWDSIM_BENCH_VUS:-40}"

run_bench() {
  local k6; k6="$(command -v k6 || true)"
  if [ -z "$k6" ]; then die "doctor --bench needs k6: it measures what k6 can push on this machine" 5; fi
  if ! command -v node >/dev/null 2>&1; then
    die "doctor --bench needs node (18+) for the local server it measures against — see docs/cli.md" 5
  fi
  local script="${CROWDSIM_BENCH_SCRIPT:-$ROOT/k6/bench.js}"
  if [ ! -f "$script" ]; then die "missing $script (is CROWDSIM_ROOT right?)" 5; fi

  mkdir -p "$OUT_DIR"
  local out="$OUT_DIR/bench-$RUN_ID.json"
  local srv_log="$OUT_DIR/.bench-$RUN_ID.log"

  say ""
  say "▶ measuring what this machine can generate (loopback, ${BENCH_DUR}, ${BENCH_VUS} VUs)"
  say "  nothing is sent to any target: the server below is started here and thrown away."
  # Measuring loopback INSIDE a VM produces a number about the VM's own network — the one layer standing
  # between this generator and any real target. Saying so here, and recording it in the artefact below, is
  # what stops the number being read back later as reassurance.
  virtualised_generator_note

  # A local server that answers a fixed body. Port 0 lets the kernel pick a free one, which it then prints:
  # hardcoding a port would collide with whatever else the developer is running.
  # node, not python3, even though python3 is the driver's own dependency: python's http.server is a thread
  # per connection and folds at a few hundred req/s on loopback — measured, with k6 reporting resets rather
  # than a ceiling. It would have made this command report the toy server's limit while calling it the
  # generator's, which is the exact species of confident wrong number the tool exists to avoid.
  node -e '
    const http = require("http");
    const body = Buffer.alloc(Number(process.argv[1]), 0x78);
    const srv = http.createServer((req, res) => {
      res.writeHead(200, { "Content-Type": "text/html", "Content-Length": body.length });
      res.end(body);
    });
    srv.keepAliveTimeout = 60000;
    srv.listen(0, "127.0.0.1", () => console.log(srv.address().port));
  ' "$BENCH_PAGE_BYTES" > "$srv_log" 2>&1 &
  local srv_pid=$!
  # Without this the shell prints "Terminated: 15" plus the whole node source when the server is killed,
  # which reads like a crash at the end of a successful measurement.
  disown "$srv_pid" 2>/dev/null || true
  # shellcheck disable=SC2064
  trap "kill $srv_pid 2>/dev/null || true" EXIT

  local port=""
  local i=0
  while [ -z "$port" ] && [ "$i" -lt 50 ]; do
    port="$(head -1 "$srv_log" 2>/dev/null | tr -dc '0-9')"
    [ -n "$port" ] && break
    sleep 0.1; i=$((i + 1))
  done
  if [ -z "$port" ]; then
    kill "$srv_pid" 2>/dev/null || true
    die "the local benchmark server did not start (see $srv_log)" 5
  fi

  set +e
  BENCH_URL="http://127.0.0.1:$port/" BENCH_OUT="$out" BENCH_DUR="$BENCH_DUR" BENCH_VUS="$BENCH_VUS" \
    BENCH_RUN_ID="$RUN_ID" "$k6" run --quiet "$script" 2>&1 | grep -vE '^\s*(execution:|script:|output:|scenarios:|default|running|\s*$)' | tail -20
  local rc="${PIPESTATUS[0]}"
  set -e
  kill "$srv_pid" 2>/dev/null || true
  trap - EXIT
  rm -f "$srv_log"

  if [ ! -f "$out" ]; then
    warn "the benchmark produced no result (k6 exit $rc)"
    return 0
  fi
  # Where it was measured travels with what was measured.
  python3 - "$out" "$(in_container && echo 1 || echo 0)" "$(virtualised_generator && echo 1 || echo 0)" \
           "$(uname -r 2>/dev/null || echo unknown)" <<'CTX'
import json, sys
path, contained, virtualised, kernel = sys.argv[1], sys.argv[2] == '1', sys.argv[3] == '1', sys.argv[4]
d = json.load(open(path))
d['in_container'] = contained
d['kernel'] = kernel
d['virtualised'] = virtualised
if virtualised:
    d['caveat'] = ("measured on loopback INSIDE A CONTAINER IN A VM: this describes the VM's own network and "
                   "says nothing about the path to a real target, which is exactly the layer that throttles "
                   "it. Not a ceiling for any run against a target.")
json.dump(d, open(path, 'w'), indent=1)
CTX
  python3 - "$out" "$BENCH_PAGE_BYTES" <<'PY'
import json, sys
d = json.load(open(sys.argv[1]))
page = int(sys.argv[2])
print(f"  ✅ this generator: {d['req_per_second']:.0f} req/s of {page/1024:.0f} KB "
      f"→ {d['mbytes_per_second']:.1f} MB/s ({d['mbits_per_second']:.0f} Mbit/s)")
print(f"     written to {sys.argv[1]} — `load` reads it when the profile declares no safety.generator_mbps")
print( "     ⚠️  loopback: this is the CEILING of this machine, not a prediction. Every real path is")
print( "         narrower — a declared safety.generator_mbps you trust still wins over this number.")
if d.get('failed_rate'):
    print(f"     ⚠️  {d['failed_rate']*100:.1f}% of the benchmark's own requests failed: the ceiling above is")
    print( "         soft, and this machine is probably busy with something else.")
PY
}

cmd_doctor() {
  if [ "${BENCH:-0}" = "1" ]; then run_bench; fi
  say "▶ crowdsim prerequisites"
  if command -v k6 >/dev/null 2>&1; then ok "k6 $(k6 version 2>/dev/null | head -1)"; else warn "k6 MISSING (see: crowdsim load)"; fi
  if command -v curl >/dev/null 2>&1; then ok "curl"; else warn "curl missing"; fi
  if command -v python3 >/dev/null 2>&1; then ok "python3"; else warn "python3 missing"; fi
  if command -v docker >/dev/null 2>&1; then ok "docker (needed only for cache-ab)"; else warn "docker missing (cache-ab unavailable)"; fi
  if command -v node >/dev/null 2>&1; then
    ok "node $(node -v 2>/dev/null) (needed only for the GUI)"
    if [ -d "$ROOT/gui/ui/dist" ]; then ok "GUI built (crowdsim serve)"; else warn "GUI not built (npm install && npm run gui:build)"; fi
  else
    warn "node missing (crowdsim serve unavailable)"
  fi
  if [ -n "${CROWDSIM_ALLOW_TARGETS:-}" ]; then ok "CROWDSIM_ALLOW_TARGETS=$CROWDSIM_ALLOW_TARGETS"; else warn "CROWDSIM_ALLOW_TARGETS unset (the profile must declare safety.allow_hosts)"; fi
  ok "output directory: $OUT_DIR"
  if [ -n "$PROFILE_F" ]; then
    resolve_profile && ok "profile '$PROFILE_F' parses, pools resolved"
    validate_profile report
    # At the profile's own ceiling: the question "can this machine even generate that" deserves an answer
    # before anybody agrees a window, not after the run comes back invalid.
    local safe; safe="$(pf safety.safe_peak_rps)"
    if [ -n "$safe" ] && resolve_target >/dev/null 2>&1; then bandwidth_note "$safe"; fi
  fi
}

# ─────────────────────────────── discover ───────────────────────────────────────────────────────────
# Pools must contain URLs that actually render. Two traps this handles:
#  · a 404 is cheap for the app tier (or, worse, is itself rendered) → it measures the wrong thing;
#  · sitemaps commonly advertise locale-prefixed paths that the site 307-redirects, so testing them
#    measures redirects instead of renders.
cmd_discover() {
  need_profile; resolve_target; gate_allowlist
  local sitemap; sitemap="$(pf discover.sitemap)"
  if [ -z "$sitemap" ]; then die "profile has no discover.sitemap" 2; fi
  local strip; strip="$(pf discover.strip_prefix_regex)"
  local out="$OUT_DIR/pool-$RUN_ID.json"
  # Announced the same way `probe` announces it, and for the same reason: the run id is how anything reading
  # this afterwards — a person, or the GUI — finds the files this command wrote.
  say "run: $RUN_ID  base: $BASE_URL"
  say "▶ discovering URLs from $sitemap (limit $LIMIT)"
  # The sitemap goes to a FILE, and python reads the file. It must not arrive on stdin: `python3 - <<PY`
  # takes the PROGRAM from stdin, so a pipe into it is silently discarded and sys.stdin.read() returns the
  # empty string. That is not hypothetical — it is how this command wrote an empty pool from 1.0.0 until
  # 1.6.0, with nothing failing and nobody noticing, because no test ever called discover.
  local raw="$OUT_DIR/.sitemap-$RUN_ID.xml"
  if ! curl -sS --max-time 30 --retry 1 --retry-connrefused "$sitemap" -o "$raw"; then
    rm -f "$raw"
    die "the sitemap did not answer: $sitemap" 4
  fi
  # The pool is the artefact a run consumes; the report next to it is the same thing as data — what the
  # sitemap offered, what survived, and (with --verify) what was dropped and why. The GUI reads the report
  # instead of scraping this log, which is the only way it can show a table that cannot drift from the run.
  python3 - "$LIMIT" "${strip:-}" "$out" "$raw" \
           "$OUT_DIR/discover-$RUN_ID.json" "$RUN_ID" "$BASE_URL" "$sitemap" <<'PY'
import json, re, sys
limit, strip, out, src = int(sys.argv[1]), sys.argv[2], sys.argv[3], sys.argv[4]
report, run_id, base, sitemap = sys.argv[5:9]
raw = open(src, encoding='utf-8', errors='replace').read()
locs = re.findall(r'<loc>\s*([^<\s]+)\s*</loc>', raw)
if not locs:
    # Loudly, because the alternative is an empty pool, which surfaces much later as "every class was
    # dropped for want of a non-empty pool" and sends you looking in the wrong place.
    sys.exit(f"no <loc> entries in {len(raw)} bytes from the sitemap — is that URL really a sitemap?")
paths = []
for u in locs:
    p = re.sub(r'^[a-z]+://[^/]+', '', u) or '/'
    if strip: p = re.sub(strip, '', p) or '/'
    if p not in paths: paths.append(p)
paths = paths[:limit]
json.dump(paths, open(out, 'w'), indent=1)
json.dump({'run_id': run_id, 'base_url': base, 'sitemap': sitemap, 'pool_path': out,
           'limit': limit, 'strip_prefix_regex': strip or None,
           'loc_entries': len(locs), 'distinct': len(paths),
           # Unverified means exactly that: nobody has asked these paths whether they render.
           'verified': False, 'kept': None, 'dropped': []},
          open(report, 'w'), indent=1)
print(f"  {len(locs)} <loc> entries → {len(paths)} distinct paths → {out}")
PY
  rm -f "$raw"
  if [ "$VERIFY" = "1" ]; then verify_pool "$out"; fi

  say ""
  say "  report (same result as data, for the GUI and for later): $OUT_DIR/discover-$RUN_ID.json"
  if [ "$VERIFY" = "1" ]; then
    say "  Point a pool at the file:"
  else
    say "  Verify they render before using them (--verify does it), then point a pool at the file:"
  fi
  say "      \"pools\": { \"pages\": \"@$(basename "$out")\" }"
  say "  ⚠️  Regenerate after every deploy: static-asset pools contain build hashes."
}

# Keep only the paths that actually render, and say what was dropped and why.
#
# Why this is not optional in spirit: a 404 is cheap for the app tier — or is itself rendered — and a 307
# measures a redirect. Either way a pool full of them yields a flattering capacity number for a load that
# never reached the renderer. The README used to say "verify them before using them", which for 400 URLs
# means nobody did.
#
# Sequential, with a pause between requests: building a pool must not itself be a load test. That is also
# why there is no --verify-concurrency.
VERIFY_DELAY="${CROWDSIM_VERIFY_DELAY:-0.05}"
verify_pool() {
  local pool="$1"
  local report="${pool%.json}.report.txt"
  local -a curl_opts=(-sS -o /dev/null --max-time 10 --retry 0)
  if [ "$INSECURE" = "1" ]; then curl_opts+=(-k); fi
  if [ -n "$HOST_HEADER" ]; then curl_opts+=(-H "Host: $HOST_HEADER"); fi
  if [ -n "$BYPASS" ]; then curl_opts+=(--resolve "${BYPASS/=/:443:}"); fi

  local total kept=0 dropped=0 path code
  total="$(python3 -c 'import json,sys; print(len(json.load(open(sys.argv[1]))))' "$pool")"
  say ""
  say "▶ verifying $total paths render (sequential, ${VERIFY_DELAY}s apart — this is not a load test)"
  : > "$report"
  printf 'verified_at=%s\nbase_url=%s\n\n' "$RUN_ID" "$BASE_URL" >> "$report"

  local keep_file="$OUT_DIR/.verified-$RUN_ID.json"
  local drop_file="$OUT_DIR/.dropped-$RUN_ID.tsv"
  : > "$keep_file.tmp"
  : > "$drop_file"
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    # -o /dev/null still transfers the body: a HEAD would be cheaper but plenty of frameworks do not
    # implement it, and a 405 would drop a page that renders perfectly well.
    code="$(curl "${curl_opts[@]}" -w '%{http_code}' "$BASE_URL$path" 2>/dev/null || echo 000)"
    case "$code" in
      2*)  kept=$((kept + 1)); printf '%s\n' "$path" >> "$keep_file.tmp" ;;
      3*)  dropped=$((dropped + 1)); printf 'redirect %s  %s\n' "$code" "$path" >> "$report"
           printf '%s\tredirect\t%s\n' "$path" "$code" >> "$drop_file" ;;
      000) dropped=$((dropped + 1)); printf 'timeout  --- %s\n' "$path" >> "$report"
           printf '%s\ttimeout\t\n' "$path" >> "$drop_file" ;;
      *)   dropped=$((dropped + 1)); printf 'status   %s  %s\n' "$code" "$path" >> "$report"
           printf '%s\tstatus\t%s\n' "$path" "$code" >> "$drop_file" ;;
    esac
    sleep "$VERIFY_DELAY"
  done < <(python3 -c 'import json,sys
for p in json.load(open(sys.argv[1])): print(p)' "$pool")

  # The pool is rewritten to what survived, and the JSON report is completed with the same verdicts the
  # text report carries — one measurement, two readers.
  python3 - "$keep_file.tmp" "$pool" "$drop_file" "$OUT_DIR/discover-$RUN_ID.json" <<'PY'
import json, os, sys
paths = [l.rstrip('\n') for l in open(sys.argv[1]) if l.strip()]
json.dump(paths, open(sys.argv[2], 'w'), indent=1)

dropped = []
try:
    for line in open(sys.argv[3], encoding='utf-8'):
        cells = line.rstrip('\n').split('\t')
        if not cells or not cells[0]:
            continue
        dropped.append({'path': cells[0], 'reason': cells[1] if len(cells) > 1 else 'unknown',
                        'status': int(cells[2]) if len(cells) > 2 and cells[2].isdigit() else None})
except OSError:
    pass

report = sys.argv[4]
try:
    d = json.load(open(report, encoding='utf-8'))
except Exception:
    d = {}
d.update({'verified': True, 'kept': len(paths), 'dropped': dropped})
json.dump(d, open(report, 'w'), indent=1)
PY
  rm -f "$keep_file.tmp" "$drop_file"

  if [ "$dropped" = "0" ]; then
    ok "all $kept paths render"
  else
    warn "$kept of $total render — $dropped dropped (why, per path: $report)"
    sed -n '4,8p' "$report" | sed 's/^/      /'
    if [ "$dropped" -gt 3 ] 2>/dev/null; then say "      … full list in $report"; fi
  fi
  if [ "$kept" = "0" ]; then
    die "every discovered path was dropped: a pool of nothing measures nothing" 4
  fi
}

# ─────────────────────────────── probe ──────────────────────────────────────────────────────────────
# ─────────────────── does an authed class actually measure an authenticated read? ───────────────────
# One request per `authed` class, sent WITHOUT the token, before any load. An endpoint that answers 200
# without an `Authorization` header turns the whole class into an anonymous GET wearing a bearer token —
# green, fast, and measuring the public path. That happened on the first authenticated smoke against a
# real target, and nothing in the tool could tell it apart from a working authenticated read.
#
# The verdicts live in lib/premise.mjs, where they are unit tested; the requests are made here, with the
# same TLS and Host flags as the rest of `probe`, because those flags are the driver's business.
authed_premise() {
  local cli="$ROOT/lib/premise-cli.mjs"
  local plan_f="$OUT_DIR/.premise-plan" obs_f="$OUT_DIR/.premise-obs"
  local has_authed
  has_authed="$(python3 -c '
import json,sys
try: d=json.load(open(sys.argv[1]))
except Exception: print(0); raise SystemExit
print(1 if any((c or {}).get("kind")=="authed" for c in (d.get("classes") or [])) else 0)' \
    "$RESOLVED" 2>/dev/null || echo 0)"
  [ "$has_authed" = "1" ] || return 0

  if ! command -v node >/dev/null 2>&1 || [ ! -f "$cli" ]; then
    say ""
    warn "this profile has an authed class and the premise could not be checked: that check needs node (18+)."
    say "     Without it nothing here can tell an authenticated read from an endpoint that ignores the"
    say "     token and answers 200 anyway — which reads as a fast, green class measuring the public path."
    return 0
  fi

  node "$cli" plan "$RESOLVED" > "$plan_f" 2>/dev/null || { rm -f "$plan_f"; return 0; }
  [ -s "$plan_f" ] || { rm -f "$plan_f"; return 0; }
  : > "$obs_f"
  local tag a b st
  while IFS="$(printf '\t')" read -r tag a b; do
    case "$tag" in
      T)  st="$(curl "${curl_opts[@]}" -D /dev/null -o /dev/null -w '%{http_code}' \
                "$BASE_URL$b" 2>/dev/null || echo 0)"
          printf 'T\t%s\t%s\t%s\n' "$a" "$b" "${st:-0}" >> "$obs_f";;
      S)  printf 'S\t%s\t%s\n' "$a" "$b" >> "$obs_f";;
    esac
  done < "$plan_f"

  say ""
  local rc=0
  node "$cli" render < "$obs_f" || rc=$?
  if [ "$rc" = "4" ]; then echo 4 > "$OUT_DIR/.premise-rc"; fi
  rm -f "$plan_f" "$obs_f"
  return 0
}

cmd_probe() {
  need_profile; resolve_target; gate_allowlist
  local log="$OUT_DIR/probe-$RUN_ID.log"
  say "▶ preflight on $BASE_URL"
  curl_opts=(-sS -o /dev/null --max-time 10 --retry 1 --retry-connrefused
             -D "$OUT_DIR/.probe-hdr")
  if [ "$INSECURE" = "1" ]; then curl_opts+=(-k); fi
  if [ -n "$HOST_HEADER" ]; then curl_opts+=(-H "Host: $HOST_HEADER"); fi
  if [ -n "$BYPASS" ]; then curl_opts+=(--resolve "${BYPASS/=/:443:}"); fi
  rm -f "$OUT_DIR/.premise-rc"

  local first; first="$(python3 -c '
import json,sys
d=json.load(open(sys.argv[1]))
p=(d.get("pools") or {}).get("pages")
print(p[0] if isinstance(p,list) and p else "/")' "$RESOLVED" 2>/dev/null || echo /)"

  {
    say "run: $RUN_ID  base: $BASE_URL  path: $first"
    local code ttfb size
    read -r code ttfb size < <(curl "${curl_opts[@]}" \
      -w '%{http_code} %{time_starttransfer} %{size_download}\n' \
      "$BASE_URL$first" 2>/dev/null) || true
    say "status=$code  ttfb=${ttfb}s  bytes=$size"
    # Also written as JSON, and it carries the cache verdict per layer as well as the weight. Prose in a log
    # is for the human reading this run; the JSON is for `load` (which reads the weight back to say what
    # bandwidth a peak implies) and for the GUI, which must show this as a table rather than make somebody
    # re-read curl output to find out whether the proxy answered.
    #
    # Only the cache-relevant headers are stored, never the whole response: a probe against a real site can
    # come back with Set-Cookie, and an archive under out/ is not the place for somebody's session.
    python3 - "$OUT_DIR/probe-$RUN_ID.json" "$RUN_ID" "$BASE_URL" "$first" \
             "${code:-0}" "${ttfb:-0}" "${size:-0}" "$OUT_DIR/.probe-hdr" "$RESOLVED" <<'PY'
import json, re, sys
dst, run_id, base, path, code, ttfb, size, hdr_file, profile = sys.argv[1:10]

KEEP = ('cache-control', 'age', 'expires', 'etag', 'last-modified', 'vary', 'server',
        'content-encoding', 'content-type', 'x-cache', 'cache-status', 'x-proxy-cache', 'x-souin')

headers = {}
try:
    for line in open(hdr_file, encoding='utf-8', errors='replace'):
        if ':' not in line:
            continue
        k, v = line.split(':', 1)
        headers[k.strip().lower()] = v.strip()
except OSError:
    pass

try:
    declared = json.load(open(profile, encoding='utf-8')).get('cache_headers') or []
except Exception:
    declared = []

# Same rule as k6/lib/classify.js layerHit, and the same three-valued answer: True hit, False miss,
# None the header never appeared. None is NOT a miss — it usually means the profile names a header this
# layer does not send, which is a profile bug that looks exactly like a cold cache.
layers = []
for l in declared:
    if not isinstance(l, dict) or not l.get('label') or not l.get('header'):
        continue
    name = str(l['header']).lower()
    pattern = l.get('hit') or 'hit'
    value = headers.get(name)
    hit = None if not value else bool(re.search(pattern, value, re.I))
    layers.append({'label': l['label'], 'header': l['header'], 'hit_pattern': pattern,
                   'value': value, 'hit': hit})

kept = {k: v for k, v in headers.items()
        if k in KEEP or k in {str(l.get('header', '')).lower() for l in declared if isinstance(l, dict)}}

json.dump({'run_id': run_id, 'base_url': base, 'path': path,
           'status': int(code or 0), 'ttfb_s': float(ttfb or 0), 'bytes': int(size or 0),
           'headers': kept, 'layers': layers},
          open(dst, 'w'), indent=1)
PY
    if [ "${code:-0}" -ge 400 ] 2>/dev/null || [ -z "${code:-}" ]; then
      say "⛔ target does not answer 2xx/3xx on the first pool entry"
    fi
    say ""
    say "── response headers (cache state of every layer it crossed) ──"
    grep -iE '^(HTTP/|cache-control|age|x-cache|cache-status|x-proxy-cache|x-souin|vary|server|content-encoding)' \
      "$OUT_DIR/.probe-hdr" 2>/dev/null || say "(none captured)"
    say ""
    say "── the layers this profile declares ──"
    # The verdict per declared layer, not just the raw headers, because "the header is not there" and "the
    # header says MISS" send you to two different places: a profile to fix, or a cache to warm.
    python3 - "$OUT_DIR/probe-$RUN_ID.json" <<'PY'
import json, sys
try:
    d = json.load(open(sys.argv[1], encoding='utf-8'))
except Exception:
    raise SystemExit
layers = d.get('layers') or []
if not layers:
    print("  (this profile declares no cache_headers: no layer can be reported)")
    raise SystemExit
width = max(len(l['label']) for l in layers)
absent = 0
for l in layers:
    if l['hit'] is None:
        absent += 1
        print(f"  {l['label']:<{width}}  {l['header']}: NOT PRESENT — nothing to classify")
    else:
        print(f"  {l['label']:<{width}}  {l['header']}: {l['value']} → "
              f"{'HIT' if l['hit'] else 'MISS'} (matches /{l['hit_pattern']}/i)")
if absent:
    print(f"  ⚠️  {absent} declared header(s) never appeared. That is usually the wrong header NAME in the")
    print("     profile rather than a cold cache — and a layer that never speaks is reported as unknown,")
    print("     never as a miss, so it cannot quietly drag a hit ratio to zero.")
PY
    authed_premise
  } | tee "$log"
  rm -f "$OUT_DIR/.probe-hdr"
  local rc="${code:-0}"
  if [ "$rc" -ge 400 ] 2>/dev/null; then exit 4; fi
  # An authed class that cannot measure an authenticated read makes the authenticated half of every run
  # from this profile meaningless, so it is an exit code and not a line somebody may scroll past. 4 is
  # probe's existing "this profile and this target do not go together".
  if [ -f "$OUT_DIR/.premise-rc" ]; then
    rm -f "$OUT_DIR/.premise-rc"
    say ""
    say "  ⛔ at least one authed class cannot measure an authenticated read (see above)"
    ok "probe log: $log"
    exit 4
  fi
  say ""
  ok "probe log: $log"
}

# ─────────────────────────────── bandwidth: the run you cannot sustain ──────────────────────────────
# generator_ok: false is diagnosed AFTER the window was agreed, the alerting silenced and the run burned —
# and most of those runs were predictable beforehand. A page weight of ~45 KB at 380 req/s is ~17.6 MB/s
# (~141 Mbit/s) sustained, which a generator behind a slow link cannot deliver no matter how many VUs k6
# provisions.
#
# `probe` already measures the weight of one page. The arithmetic was available before the run and nothing
# was doing it. It is a WARNING and never a gate: the estimate assumes every request weighs what that one
# page weighed, which is wrong in both directions (assets are smaller, search results larger), and a wrong
# estimate must never be able to stop a run somebody needs. The one thing it must not do is stay silent.
# ─────────── the generator that cannot win: a container on a macOS/Windows host ─────────────────────
# That the Docker network layer on macOS and Windows saturates before the target does is measured, and it
# has been documented in three places — while the tool happily let the run happen and reported
# generator_ok: false afterwards, which is the failure the bandwidth estimate exists to pre-empt.
#
# What can actually be detected, checked from inside a container rather than assumed:
#   · /.dockerenv (and the cgroup path, on older setups) says we are in a container;
#   · `uname -r` says `…-linuxkit` under Docker Desktop and `…-microsoft-standard-WSL2` under WSL2 — both
#     mean the container is inside a VM, with the host's network stack behind a translation layer.
#
# It WARNS and does not refuse, deliberately. The detection has a false negative for every VM runtime that
# does not brand its kernel (Colima and friends), and refusing on a signal that misses half the cases buys
# nothing; while a false positive — Docker Desktop on a Linux host — is a case where the warning is still
# correct, because the VM boundary is the problem, not the operating system on the other side of it.
# A detection that can be wrong must not become a gate.
# In a container? Also used by the benchmark, which has to record where its number came from.
in_container() {
  local marker="${CROWDSIM_CONTAINER_MARKER:-/.dockerenv}"
  [ -e "$marker" ] || grep -qE 'docker|containerd|kubepods' /proc/1/cgroup 2>/dev/null
}

# In a container inside a VM: the case where the network path is what gets measured, not the target.
virtualised_generator() {
  in_container || return 1
  case "$(uname -r 2>/dev/null || echo unknown)" in
    *linuxkit*|*microsoft*|*WSL*) return 0;;
    *) return 1;;
  esac
}

virtualised_generator_note() {
  virtualised_generator || return 0
  local kernel; kernel="$(uname -r 2>/dev/null || echo unknown)"

  warn "THIS GENERATOR IS IN A CONTAINER INSIDE A VM (kernel $kernel)."
  say  "     On macOS and Windows the Docker network layer saturates before your target does: the"
  say  "     iterations get dropped, the summary comes back generator_ok: false, and the window is gone."
  say  "     Measured, repeatedly. It is not a tuning problem."
  say  "     → run k6 natively on this machine, or put this container on a Linux host near the target."
  say  "     The GUI in a container is fine anywhere: it is a page, not a generator."
}

bandwidth_note() {
  local peak="$1" declared
  declared="$(pf safety.generator_mbps)"
  python3 - "$OUT_DIR" "$BASE_URL" "$peak" "${declared:-}" <<'PY'
import glob, json, os, sys
out_dir, base, peak, declared = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
try:
    peak = float(peak)
except ValueError:
    raise SystemExit
found = []
for f in sorted(glob.glob(os.path.join(out_dir, 'probe-*.json'))):
    try:
        d = json.load(open(f))
    except Exception:
        continue
    if d.get('base_url') == base and d.get('bytes'):
        found.append(d)
if not found:
    print("  ℹ️  bandwidth: unknown — run 'crowdsim probe' against this target and this becomes a number")
    raise SystemExit
d = found[-1]                      # newest, since probe-<run_id> sorts chronologically
weight = int(d['bytes'])
mbytes = peak * weight / 1_000_000
mbits = mbytes * 8
# Scale the units to the number. A 46-byte test page printed as "0 KB ≈ 0.0 MB/s" reads like a broken
# calculation, and a reader who distrusts the format distrusts the warning underneath it.
size = f"{weight/1024:.0f} KB" if weight >= 1024 else f"{weight} B"
rate = f"{mbytes:.1f} MB/s" if mbytes >= 1 else f"{peak * weight / 1000:.1f} KB/s"
link = f"{mbits:.0f} Mbit/s" if mbits >= 1 else f"{mbits:.3g} Mbit/s"
print(f"  ℹ️  bandwidth: {peak:g} req/s × {size} ≈ {rate} ({link}) sustained, from probe {d['run_id']}")

source = 'declared'
if not declared:
    # Nothing declared: fall back to what this machine was measured doing, if anybody measured it.
    # A measured ceiling is better than silence and worse than a value somebody chose knowing the uplink —
    # which is why a declared number wins, and why this one is labelled every time it is used.
    bench = []
    for f in sorted(glob.glob(os.path.join(out_dir, 'bench-*.json'))):
        try:
            b = json.load(open(f))
        except Exception:
            continue
        if b.get('mbits_per_second'):
            bench.append(b)
    if bench and bench[-1].get('virtualised'):
        # Loopback inside a VM measures the VM. Using it as a ceiling would buy silence in the one place the
        # warning matters most: a container on a macOS or Windows host.
        print("     The only measurement available was measured inside a container in a VM, which")
        print("     says nothing about the path to a real target — that is the layer which throttles it.")
        print("     Declare safety.generator_mbps, or measure on the host that will generate the load.")
        raise SystemExit
    if not bench:
        print("     A generator that cannot sustain that will report generator_ok: false — an invalid run,")
        print("     not a slow one. Declare safety.generator_mbps, or measure it: crowdsim doctor --bench")
        raise SystemExit
    declared = bench[-1]['mbits_per_second']
    source = 'measured'
    print(f"     no safety.generator_mbps declared; using the loopback ceiling measured on this machine "
          f"({declared:.0f} Mbit/s, {bench[-1].get('measured_at')}).")
    print("     That is an UPPER BOUND: the path to a real target is narrower, always. Declaring the real")
    print("     uplink in the profile gives a warning worth acting on.")
try:
    have = float(declared)
except ValueError:
    raise SystemExit
if source == 'measured' and mbits <= have:
    # Under a ceiling that flatters you is not reassurance worth printing as a verdict.
    raise SystemExit
said = 'IS DECLARED TO SUSTAIN' if source == 'declared' else 'WAS MEASURED DOING ON LOOPBACK'
if mbits > have:
    print(f"  ⚠️  THAT IS MORE THAN THE {have:g} Mbit/s THIS GENERATOR {said}.")
    print("     Expect generator_ok: false. Move the generator closer to the target, or lower the peak —")
    print("     do not lower the SLO.")
elif mbits > 0.8 * have:
    word = 'declared' if source == 'declared' else 'measured'
    print(f"  ⚠️  that is within 20% of the {word} {have:g} Mbit/s: watch generator_ok on this run")
PY
}

# ─────────────────────────────── load ───────────────────────────────────────────────────────────────
cmd_load() {
  need_profile
  # Before the gates and before k6: a profile with errors produces a run that fails in the init context, or
  # worse, one that runs and measures something other than what was asked for.
  validate_profile gate
  resolve_profile; resolve_target
  gate_allowlist
  gate_peak
  # A warm-up generates real load, so it passes the same gates. Priming is not a way around the ceiling.
  if [ -n "${WARMUP_DUR:-}" ]; then
    case "$WARMUP_DUR" in
      *[0-9]s|*[0-9]m|*[0-9]h|*[0-9]ms) ;;
      *) die "--warmup takes a duration like 30s or 2m (got: $WARMUP_DUR)" 2;;
    esac
    WARMUP_PEAK="${WARMUP_PEAK:-$START}"
    PEAK_SAVED="$PEAK"; PEAK="$WARMUP_PEAK"
    gate_peak
    PEAK="$PEAK_SAVED"
  fi

  # A profile whose fixed per-class rates already exceed --peak is refused HERE, with an exit code, rather
  # than in the generator's init context: `--peak` is the total, and the arithmetic that decides it is the
  # same one k6/lib/mix.js runs (the generator refuses too, as a backstop that cannot drift).
  local pin_rc=0
  python3 - "$RESOLVED" "$PEAK" <<'PY' || pin_rc=$?
import json, sys
profile, peak = sys.argv[1], float(sys.argv[2])
classes = json.load(open(profile, encoding='utf-8')).get('classes') or []
fixed = 0.0
pinned = []
for c in classes:
    r = c.get('rate_rps')
    try:
        r = float(r)
    except (TypeError, ValueError):
        continue
    if r > 0:
        fixed += r
        pinned.append(f"{c.get('name')} {r:g}")
if fixed > peak:
    print(f"  the classes with a fixed rate ask for {fixed:g} req/s ({', '.join(pinned)}), which is more "
          f"than --peak {peak:g}.")
    print("  --peak is the TOTAL: raise it, or lower the fixed rates. They are not scaled down to fit —")
    print("  the run would then measure a rate nobody asked for and report it under the one they did.")
    raise SystemExit(2)
if pinned and len(pinned) == len(classes) and fixed < peak:
    print(f"  ⚠️  every class declares a fixed rate: this run generates {fixed:g} req/s, not --peak "
          f"{peak:g}. --peak is the ceiling here, not the target.")
PY
  if [ "$pin_rc" != "0" ]; then
    die "the profile asks for more than --peak: see above" 2
  fi

  bandwidth_note "$PEAK"
  virtualised_generator_note
  k6_bin

  local summary="$OUT_DIR/summary-$RUN_ID.json"
  local log="$OUT_DIR/load-$RUN_ID.log"

  local -a env=(
    "PROFILE=$RESOLVED" "BASE_URL=$BASE_URL" "RUN_ID=$RUN_ID" "SHAPE=$SHAPE"
    "PEAK_RPS=$PEAK" "START_RPS=$START" "STEPS=$STEPS" "STEP_DUR=$STEP_DUR" "HOLD_DUR=$HOLD"
    "RSC_MODE=$RSC_MODE" "ABORT_DELAY=$ABORT_DELAY" "SUMMARY_OUT=$summary"
    "INSECURE=$INSECURE" "SKIP_CLASSES=$SKIP_CLASSES"
  )
  if [ -n "$HOST_HEADER" ]; then env+=("HOST_HEADER=$HOST_HEADER"); fi
  if [ -n "$BYPASS" ]; then env+=("BYPASS=$BYPASS"); fi
  if [ -n "$MAX_5XX" ]; then env+=("MAX_5XX=$MAX_5XX"); fi
  if [ -n "$MAX_P95" ]; then env+=("MAX_P95_MS=$MAX_P95"); fi
  # Credentials for the authenticated classes: a PATH, never the credentials themselves. Passed through
  # so the profile can stay shareable — see the auth block in profiles/example.json.
  if [ -n "${CROWDSIM_AUTH_USERS:-}" ]; then env+=("CROWDSIM_AUTH_USERS=$CROWDSIM_AUTH_USERS"); fi
  # Only for --shape journey. Passing it in `mix` mode would make k6 open a file it never uses, and a
  # profile that merely mentions a journey file it does not ship would abort the run in the init context
  # with a stack trace instead of a load test.
  if [ "$SHAPE" = "journey" ]; then
    local j; j="$(pf journey.file)"
    if [ -z "$j" ]; then die "--shape journey needs journey.file in the profile" 2; fi
    local jpath="$(cd "$(dirname "$PROFILE_F")" && pwd)/$j"
    if [ ! -f "$jpath" ]; then die "--shape journey: journey file not found: $jpath" 2; fi
    env+=("JOURNEY=$jpath")
  fi

  # The warm-up: its own k6 invocation, its own summary file, no brake. Two runs rather than one filtered
  # one, because filtering is where a caveat gets lost — nothing here can fold priming traffic into the
  # measurement, since the measurement is a different process reading a different file.
  local -a warm_env=() warm_args=()
  local warm_summary="" warm_log="" warmed_by=""
  if [ -n "${WARMUP_DUR:-}" ]; then
    warm_summary="$OUT_DIR/warmup-$RUN_ID.json"
    warm_log="$OUT_DIR/warmup-$RUN_ID.log"
    warmed_by="$WARMUP_DUR at $WARMUP_PEAK req/s"
    warm_env=("${env[@]}" "WARMUP=1" "PEAK_RPS=$WARMUP_PEAK" "START_RPS=$WARMUP_PEAK" "STEPS=1"
              "STEP_DUR=$WARMUP_DUR" "HOLD_DUR=0s" "SUMMARY_OUT=$warm_summary")
    for e in "${warm_env[@]}"; do warm_args+=(-e "$e"); done
    env+=("WARMED_BY=$warmed_by")
  fi

  local -a k6args=()
  for e in "${env[@]}"; do k6args+=(-e "$e"); done

  say "╔═══ crowdsim ═════════════════════════════════════════════════════════════════╗"
  say "  run       $RUN_ID"
  say "  target    $BASE_URL"
  say "  profile   $PROFILE_F"
  say "  shape     $SHAPE   peak ${PEAK} → hold ${HOLD}   steps ${STEPS}×${STEP_DUR}"
  if [ -n "$warmed_by" ]; then
    say "  warm-up   $warmed_by, excluded from the numbers (its own summary: $(basename "$warm_summary"))"
  fi
  say "╚══════════════════════════════════════════════════════════════════════════════╝"

  if [ "$DRY" = "1" ]; then
    if [ -n "$warmed_by" ]; then say "(dry run) warm-up: k6 run ${warm_args[*]} $K6_SCRIPT"; fi
    say "(dry run) k6 run ${k6args[*]} $K6_SCRIPT"
    return 0
  fi

  if [ -n "$warmed_by" ]; then
    say ""
    say "▶ warm-up: $warmed_by. Priming the caches in front of the target — no brake, and none of this"
    say "  reaches the measurement below. A run against a cold cache measures a cold cache."
    set +e
    "$K6" run "${warm_args[@]}" "$K6_SCRIPT" 2>&1 | tee "$warm_log" | tail -3
    set -e
    ok "warm-up done (kept apart in $(basename "$warm_log"))"
    say ""
  fi

  # The brake tripping means k6 exits non-zero. That is an OUTCOME (you found the knee), not a failure
  # of the tool, so it must not kill the wrapper before the summary is written and recorded.
  set +e
  "$K6" run "${k6args[@]}" "$K6_SCRIPT" 2>&1 | tee "$log"
  local k6rc="${PIPESTATUS[0]}"
  set -e

  if [ -f "$summary" ]; then
    record_history "$summary"
    write_signup_manifest "$summary" "$log"
    if [ "$SLACK" = "1" ]; then notify_slack "$summary"; fi
    ok "summary: $summary"
    ok "log:     $log"
    local flags
    flags="$(python3 -c 'import json,sys
d=json.load(open(sys.argv[1]))
print(d.get("generator_ok"), d.get("target_unreachable"))' "$summary")"
    if [ "${flags% *}" != "True" ]; then
      warn "THE GENERATOR DID NOT HOLD THE RATE — discard this run, do not interpret it."
      warn "Move the generator closer to the target (or onto a bigger host) and repeat."
    fi
    if [ "${flags#* }" = "True" ]; then
      warn "THE TARGET NEVER ANSWERED — this is a connectivity problem, not a capacity result."
      warn "Run 'crowdsim probe' against the same target before trying again."
    fi
  else
    # Exit 4, not 0. `0` means EXECUTED — a run the brake stopped is an outcome and keeps 0 — but a
    # generator that never produced a summary did not run at all: a bad journey file, a profile it refuses
    # in its init context, a credentials CSV with no accounts in it, an out-of-memory. Until 1.20.4 this
    # warned on a terminal and returned 0, so a Nomad batch and a CI job recorded a run that never
    # happened as a success. A scheduler cannot read a warning.
    die "no summary produced: the generator exited $k6rc without completing a run, so there is nothing to
  interpret and nothing went into the history. This is not a result — see $log for what k6 said.
  A profile the generator refuses in its init context fails exactly like this: a missing journey file, or
  a credentials CSV that parsed to no accounts." 4
  fi
  return 0
}

# The accounts a signup run created, collected where they can be found again.
#
# A signup class at 40/s for five minutes creates twelve thousand real accounts in a real identity
# provider. The StreamWay+ campaign left ~2,970 behind and had to open a ticket to hunt them down. crowdsim
# is the one thing that knows what they were, and it recorded nothing.
#
# The identities come out of the run log, because a k6 VU has no other channel: VUs are isolated, so there
# is no shared array to append to and read in handleSummary. The log is a file the driver already keeps.
#
# Written to $OUT_DIR and nowhere else, and never with a password in it. This file names real accounts on a
# real system: out/ is gitignored, and it must stay out of any repository.
write_signup_manifest() {
  local summary="$1" log="$2"
  local dest="$OUT_DIR/signups-$RUN_ID.json"
  python3 - "$summary" "$log" "$dest" "$BASE_URL" <<'PY' || return 0
import json, re, sys

summary_path, log_path, dest, target = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
d = json.load(open(summary_path, encoding='utf-8'))
sign = d.get('signup')
if not sign:
    raise SystemExit(0)          # no signup class in this run: no manifest, not an empty one

emails, seen = [], set()
try:
    with open(log_path, encoding='utf-8', errors='replace') as fh:
        for line in fh:
            for m in re.finditer(r'crowdsim-signup ([^\s"\\]+)', line):
                e = m.group(1)
                if e not in seen:
                    seen.add(e)
                    emails.append(e)
except OSError:
    pass

manifest = {
    'run_id': d.get('run_id'),
    'class': sign.get('class'),
    'target': target or d.get('base_url'),
    'signup_url': sign.get('url'),
    'email_pattern': sign.get('email_pattern'),
    'tag_prefix': sign.get('tag_prefix'),
    'email_glob': sign.get('email_glob'),
    'created': sign.get('created'),
    'failed': sign.get('failed'),
    'emails': emails,
    '_comment': ("These accounts EXIST on the target above. crowdsim created them and will not delete "
                 "them: removing accounts from somebody's identity provider is not a load generator's "
                 "job, and a tool that could do it would be a tool that could do it by accident. Use "
                 "email_glob to find them. No password is recorded here, by design — and this file names "
                 "real accounts on a real system, so it belongs where the run output belongs: out/ is "
                 "gitignored, keep it that way and out of any public repository."),
}
json.dump(manifest, open(dest, 'w', encoding='utf-8'), indent=1, ensure_ascii=False)
listed = len(emails)
print(f"  ⚠️  this run CREATED {manifest['created']} accounts on {manifest['target']} — they still exist")
print(f"     manifest: {dest}  ({listed} listed by address)")
print(f"     find them all: {manifest['email_glob']}")
print("     crowdsim will not delete them: that is not a load generator's job. And do not commit that")
print("     file — it names real accounts on a real system.")
PY
}

record_history() {
  if [ ! -f "$HISTORY_F" ]; then
    printf 'run_id\tprofile\tbase_url\tshape\tpeak\taborted\treqs\trps\tfailed\tp95\te504\tgen_ok\tknee_clean\tknee_crossed\n' > "$HISTORY_F"
  fi
  python3 - "$1" >> "$HISTORY_F" <<'PY'
import json, sys
d = json.load(open(sys.argv[1]))
f = lambda x: '' if x is None else x
# The knee is the only pair of numbers in this row that describes a rate the system was actually measured
# at. Left EMPTY when the run could not support one (see k6/lib/knee.js): an empty cell is a run with no
# knee, a 0 would be a knee at zero req/s.
k = d.get('knee') or {}
clean = None if k.get('refused') else ((k.get('clean') or {}).get('requested_rps'))
crossed = None if k.get('refused') else ((k.get('crossed') or {}).get('requested_rps'))
print('\t'.join(str(f(v)) for v in [
    d['run_id'], d.get('profile'), d['base_url'], d['shape'], d['peak_rps_user_target'],
    d['aborted'], d['requests'], round(d['rps_avg'], 1), round(d['failed_rate'], 4),
    round(d['dur']['p95'] or 0), d['e504'], d['generator_ok'], clean, crossed]))
PY
}

cmd_history() {
  if [ ! -f "$HISTORY_F" ]; then say "no runs yet ($HISTORY_F)"; return 0; fi
  # Aligned in python3, not with column(1): column comes from util-linux and busybox does not have it, so
  # inside the published image this subcommand used to fail with 127 — the one command whose entire job is
  # to print a file. python3 is already a hard runtime dependency; column never was.
  python3 - "$HISTORY_F" <<'PY'
import sys
rows = [l.rstrip('\n').split('\t') for l in open(sys.argv[1], encoding='utf-8') if l.strip()]
if not rows:
    raise SystemExit(0)
width = max(len(r) for r in rows)
rows = [r + [''] * (width - len(r)) for r in rows]
pads = [max(len(r[i]) for r in rows) for i in range(width)]
for r in rows:
    print('  '.join(c.ljust(pads[i]) for i, c in enumerate(r)).rstrip())
PY
}

# ─────────────────────────────── compare: the only honest number ─────────────────────────────────────
# This tool measures DELTAS honestly and absolutes optimistically: a synthetic pool of cold URLs is more
# severe than real traffic, so "p95 was 240 ms" travels badly and "p95 fell 38% after the cache change" is
# the claim worth making. Until now that comparison was done by opening two summary files side by side.
#
# The value is entirely in what it REFUSES. Two runs at different URL pools are two different experiments,
# and a run with generator_ok: false has no numbers at all — comparing either quietly produces a confident
# figure with nothing behind it, which is worse than no comparison. So mismatches stop the command (exit 2)
# instead of appearing as a footnote nobody reads.
# ─────────────────────────────── report: the result, with its caveats ────────────────────────────────
# Every run ends up in a document — an incident write-up, a ticket, a message to whoever asked — and that
# meant retyping numbers out of the terminal. The caveats are exactly what does not survive the retyping:
# generator_ok, that the pool was synthetic and colder than real traffic, that only the delta is defensible,
# that a brake abort is a result rather than a failure. The tool knew all of it and handed over a JSON file.
#
# Nothing here is computed: every figure comes from the summary, and anything the archive does not contain is
# absent instead of estimated. A comparison is `crowdsim compare`, not a second delta.
# ─────────────────────────────── weights: the mix, measured ──────────────────────────────────────────
# The class mix is the one input this tool insists must be measured — every page of the documentation says
# the weights have to come from your own edge log, and `init` writes them as a TODO for that reason. Nothing
# here read a log, so the most important number in a profile was left to somebody counting lines by hand.
#
# What this deliberately does NOT do is go and fetch the log. That would mean privileged access to a
# production edge, which this project does not want: the log arrives as a file, or on stdin.
#
# The rules live in lib/weights.mjs, where they are tested. That means node — stated, like `record` and
# `validate`, rather than discovered halfway through.
weights_runner() {
  if ! command -v node >/dev/null 2>&1; then
    die "crowdsim weights needs node (18+): the classification rules live in lib/weights.mjs, where
  they are tested" 5
  fi
  local runner="$ROOT/lib/weights-cli.mjs"
  if [ ! -f "$runner" ]; then die "missing $runner (is CROWDSIM_ROOT right?)" 5; fi
  printf '%s' "$runner"
}

cmd_weights() {
  need_profile
  local runner; runner="$(weights_runner)"
  local log="${POSITIONAL[0]:-}"
  local -a args=("$runner" --profile "$PROFILE_F")
  # No file and no `-`: reading stdin is the normal case, and the runner is the one that refuses when
  # stdin is a terminal — it can tell, and it prints the two forms that work.
  if [ -n "$log" ] && [ "$log" != "-" ]; then
    [ -f "$log" ] || die "no such file: $log" 2
    args+=("$log")
  fi
  if [ -n "${LOG_FORMAT:-}" ]; then args+=(--format "$LOG_FORMAT"); fi
  if [ -n "${LOG_TOP:-}" ]; then args+=(--top "$LOG_TOP"); fi
  if [ "${WEIGHTS_JSON:-0}" = "1" ]; then args+=(--json); fi
  # exec, so the runner owns stdin and its exit code is ours. Nothing is written anywhere: an access log
  # holds URLs, addresses and user agents, and out/ is a directory people copy from.
  exec node "${args[@]}"
}

# ─────────────────────────────── init: the first profile ─────────────────────────────────────────────
# The profile is the whole configuration, and writing the first one is the highest step in this tool. Most of
# it has already been measured by the time somebody asks: `probe` knows the page weight and which cache
# layers answered, `discover --verify` has a pool of URLs that actually render, `record` has a real fan-out.
# Those artefacts sit in out/ and nothing assembled them.
#
# With --access-log it also fills in the class weights, from the operator's own log, through the same rules
# `crowdsim weights` uses. Everything else it cannot measure stays a TODO: a plausible number is worse than
# an obvious hole, because a hole gets filled in.
#
# Two things this must never do, and they are the reason it exists rather than a template in the README:
#  · fill in safety.allow_hosts — that would be crowdsim authorising a host on your behalf;
#  · fill in safety.safe_peak_rps — that would be crowdsim deciding how far somebody's production may bend.
# Both are left empty, the file says why, and `validate` refuses it until a human fills them in.
cmd_init() {
  local out="${INIT_OUT:-${POSITIONAL[0]:-}}"
  if [ -z "$out" ]; then out="$OUT_DIR/profile-draft.json"; fi
  if [ -e "$out" ]; then
    die "$out already exists — a profile you have already written is not ours to replace" 2
  fi
  # A profile is a map of your infrastructure, and the profile directory is the one that gets committed.
  local pdir="${CROWDSIM_PROFILES:-$ROOT/profiles}"
  local dest_dir; dest_dir="$(cd "$(dirname "$out")" 2>/dev/null && pwd || echo "$(dirname "$out")")"
  local pdir_abs; pdir_abs="$(cd "$pdir" 2>/dev/null && pwd || echo "$pdir")"
  if [ "$dest_dir" = "$pdir_abs" ]; then
    die "refusing to write into the profile directory ($pdir_abs) without being asked twice.

  A profile names real routes on a real host, and that directory is the one that gets committed. Write it
  somewhere else and move it deliberately, or keep it in your own private repo." 2
  fi

  # Checked here rather than after the draft exists: a half-drafted profile that then failed for want of
  # node would leave a file the next run refuses to overwrite.
  local weights_cli=""
  if [ -n "${ACCESS_LOG:-}" ]; then
    [ -f "$ACCESS_LOG" ] || die "no such file: $ACCESS_LOG" 2
    weights_cli="$(weights_runner)"
  fi

  mkdir -p "$(dirname "$out")"
  local rc=0
  python3 - "$OUT_DIR" "$out" "${ACCESS_LOG:-}" <<'PY' || rc=$?
import glob, json, os, sys

out_dir, dest = sys.argv[1], sys.argv[2]
access_log = sys.argv[3] if len(sys.argv) > 3 else ''

def newest(prefix, needs=None):
    for f in sorted(glob.glob(os.path.join(out_dir, prefix + '-*.json')), reverse=True):
        try:
            d = json.load(open(f, encoding='utf-8'))
        except Exception:
            continue
        if needs is None or needs(d):
            return d
    return None

probe = newest('probe', lambda d: d.get('base_url'))
disc = newest('discover', lambda d: d.get('pool_path'))
journey = newest('journey', lambda d: d.get('pages'))

if not probe and not disc:
    print("  ❌ nothing to build a profile from: out/ has no probe and no discover artefact.")
    print("     Measure the site first — those two commands are what this assembles:")
    print("       crowdsim probe    --profile <p.json> --target <name>")
    print("       crowdsim discover --profile <p.json> --verify")
    print("     Yes, that needs a profile: start from profiles/example.json for the first probe, then let")
    print("     this command write the real one from what the probe found.")
    raise SystemExit(4)

base_url = (probe or disc).get('base_url')
weight = (probe or {}).get('bytes')
layers = (probe or {}).get('layers') or []
# Relative to the DRAFT, not to out/: the reference is resolved from the profile's own directory, so a
# draft written anywhere else pointed at a pool file that was not there. `init --out ~/p.json` produced a
# profile whose pool silently could not be read.
_pool_path = (disc or {}).get('pool_path') or ''
pool_file = None
if _pool_path:
    _abs = _pool_path if os.path.isabs(_pool_path) else os.path.join(out_dir, os.path.basename(_pool_path))
    pool_file = os.path.relpath(os.path.abspath(_abs), os.path.dirname(os.path.abspath(dest)))
verified = (disc or {}).get('verified')

provenance = []
if probe:
    provenance.append(f"probe {probe.get('run_id')}: target, page weight {weight} B, "
                      f"{len(layers)} declared cache layer(s)")
if disc:
    kept = disc.get('kept')
    provenance.append(f"discover {disc.get('run_id')}: pool {pool_file}"
                      + (f", {kept} of {disc.get('distinct')} verified to render" if verified else
                         ", NOT VERIFIED — nobody has asked these paths whether they render"))
if journey:
    provenance.append(f"record: a journey of {len(journey.get('pages') or [])} page(s)")

profile = {
    '_comment': 'Drafted by `crowdsim init` from the artefacts in out/. Every value here came from a '
                'measurement or is marked TODO — nothing was guessed. Read the TODOs before running it.',
    '_provenance': provenance,
    'name': 'TODO-name-this-profile',
    'description': f'Drafted from a probe of {base_url}. TODO: say what this profile is for.',
    'targets': {
        'default': 'edge',
        'list': {
            'edge': {
                'base_url': base_url,
                '_comment': 'From the probe. TODO: add `bypass` to skip the CDN and hit your own edge '
                            'directly, keeping SNI and Host correct — that is usually the target you want.',
            },
        },
    },
    '_classes_comment': 'TODO: THE WEIGHTS BELOW ARE A STARTING POINT, NOT A MEASUREMENT. They must come '
                        'from your own edge log — crowdsim does not read logs, by choice, and a mix nobody '
                        'measured is a guess wearing a number. Add or remove classes to match what your '
                        'frontend actually serves.',
    'classes': [
        {'name': 'html', 'weight': 40, 'pool': 'pages',
         '_comment': 'TODO: weight from your edge log — or hand the log over with `crowdsim init '
                     '--access-log <file>` and this number is measured instead. slo.brake_class names this '
                     'class, because the document is what falls over first on a server-rendered frontend. A '
                     'class may also declare its own max_p95_ms, which may only be sharper than the '
                     'profile\'s.'},
        {'name': 'rsc_page', 'weight': 45, 'pool': 'pages', 'kind': 'rsc',
         '_comment': 'TODO: framework navigation requests (React Server Components, Turbo, Inertia). '
                     'Remove this class if your frontend does not make them.'},
        {'name': 'static', 'weight': 15, 'pool': 'assets',
         'log_match': ['/_next/static/*', '/assets/*', '/static/*'],
         '_comment': 'TODO: point `assets` at a pool of real static URLs — a static pool contains build '
                     'hashes and goes stale on every deploy. log_match is how `crowdsim weights` finds '
                     'these requests in an access log; TODO: check those three globs against your own '
                     'paths, they are the common ones and not necessarily yours.'},
    ],
    'pools': {
        'pages': ('@' + pool_file) if pool_file else ['/', 'TODO-add-real-paths'],
        'assets': ['TODO-add-real-asset-paths'],
    },
    'rsc': {'mode': 'repeat', 'param': '_rsc',
            '_comment': 'repeat reproduces what a real Next.js build does (few distinct navigation URLs). '
                        'random measures the opposite hypothesis. Do not swap them between runs you compare.'},
    'cache_headers': [
        {'label': l.get('label'), 'header': l.get('header'), 'hit': l.get('hit_pattern') or 'hit',
         '_comment': ('seen answering in the probe' if l.get('hit') is not None else
                      'declared, but this header never appeared in the probe: check the NAME before '
                      'trusting a hit ratio for this layer')}
        for l in layers
    ],
    'slo': {
        'max_p95_ms': 'TODO-number-of-ms',
        'max_failed_rate': 0.02,
        'guillotine_ms': 'TODO-your-proxy-read-timeout-in-ms',
        'brake_class': 'html',
        '_comment': 'TODO: max_p95_ms is the latency past which you consider the site broken, and '
                    'guillotine_ms MUST be your reverse proxy\'s read timeout — it is where 504s come '
                    'from, and the k6 request timeout has to exceed it or the 504s are invisible. A class '
                    'may declare its own max_p95_ms to make the brake sharper for it.',
    },
    'safety': {
        'allow_hosts': [],
        'safe_peak_rps': None,
        '_comment': 'LEFT EMPTY ON PURPOSE, and validate will refuse this file until you fill them in. '
                    'allow_hosts is the allowlist: crowdsim never authorises a host on your behalf, not '
                    'even one it just probed. safe_peak_rps is the rate past which a run needs '
                    '--i-know-this-breaks-production typed on the command line: it is a decision about how '
                    'far someone else\'s production may bend, and no tool gets to make it for you.',
    },
}
if pool_file and verified is False:
    profile['pools']['_comment'] = ('The pages pool is NOT VERIFIED: nobody has asked those paths whether '
                                   'they render. Re-run discover with verification before a load run uses '
                                   'them — a pool of 404s measures your error page at full speed.')
if journey:
    profile['journey'] = {'file': 'TODO-path-to-the-journey-file-record-wrote',
                          '_comment': 'Only used with --shape journey. `crowdsim record` writes this file.'}

json.dump(profile, open(dest, 'w', encoding='utf-8'), indent=1, ensure_ascii=False)
print(f"  ✅ drafted {dest}")
for line in provenance:
    print(f"     from {line}")
# With a log to read, the mix is measured in a second pass and the closing summary belongs to it: printing
# "the weights are a starting point" here and "measured" a moment later would be two answers to one question.
if not access_log:
    print("")
    print("  It will NOT run yet, by design:")
    print("     · safety.allow_hosts and safety.safe_peak_rps are empty — fill them in;")
    print("     · the class weights are a starting point, not your traffic mix — `crowdsim init")
    print("       --access-log <file>` measures them from your own log instead;")
    print("     · slo.max_p95_ms and slo.guillotine_ms are TODO, and the second must be your proxy's read")
    print("       timeout, or the 504s a run produces will be invisible to it.")
    print("")
    print(f"  Then:  crowdsim validate {dest}")
PY
  if [ "$rc" != "0" ]; then rm -f "$out"; exit "$rc"; fi
  if [ -z "${ACCESS_LOG:-}" ]; then return 0; fi

  # The mix, measured, through exactly the rules `crowdsim weights` uses — against the draft that was just
  # written, because a class is recognised by what the profile declares and the draft IS the profile now.
  say ""
  say "▶ measuring the mix on $ACCESS_LOG"
  local mix rc2=0
  # stdout only: the runner writes its warnings to stderr, and folding them into the capture put a "⚠️" line
  # in front of the JSON — which parsed as nothing at all.
  mix="$(node "$weights_cli" "$ACCESS_LOG" --profile "$out" --json)" || rc2=$?
  if [ "$rc2" != "0" ]; then
    # The draft is kept: it is correct, only its weights are still a guess. Deleting it would throw away the
    # probe and discover artefacts it assembled because a log did not parse.
    warn "the log could not be turned into a mix (exit $rc2) — $out keeps its placeholder weights"
    say "     Fix the log or the format, then:  crowdsim weights $ACCESS_LOG --profile $out"
    exit "$rc2"
  fi
  # --json carries counts, shares and the window and NO paths: the draft lands in out/, and an access log's
  # URLs are not this tool's data to keep.
  # The mix travels as an argument, not on stdin: the heredoc below already owns stdin, and a pipe into it
  # silently delivered nothing — caught the first time this ran.
  python3 - "$out" "$mix" <<'PYMIX'
import json, sys
dest = sys.argv[1]
mix = json.loads(sys.argv[2])
profile = json.load(open(dest, encoding='utf-8'))

DRAFT_TODO = ('TODO: weight from your edge log — or hand the log over with `crowdsim init --access-log '
              '<file>` and this number is measured instead. ')
by = {c['name']: c for c in mix['classes']}
measured, absent = [], []
for c in profile['classes']:
    m = by.get(c['name'])
    if m and m['weight']:
        c['weight'] = m['weight']
        c['_comment'] = (f"weight measured: {m['count']} requests, {m['share']*100:.1f}% of what was "
                         f"classified. " + str(c.get('_comment', '')).replace(DRAFT_TODO, ''))
        measured.append(c['name'])
    elif m and m.get('countable') is False:
        # A login or a signup POSTs, and `weights` counts GETs only: no access log can ever produce a
        # number for it. Saying "NOT ONCE in the log" about a class that signs in on every session would
        # send somebody looking for it in the wrong file.
        c['_comment'] = (f"TODO: a {m.get('declared_kind', 'write')} class cannot be measured from an "
                         'access log — it POSTs, and `crowdsim weights` counts GETs. Set this weight from '
                         'the rate you measured yourself (logins per second in the window you care '
                         'about). ' + str(c.get('_comment', '')))
        absent.append(c['name'])
    else:
        # A class the log never showed keeps its placeholder weight and gains a TODO rather than being
        # deleted: it may be traffic this window did not contain, and dropping a class silently is how a
        # mix loses its tail.
        c['_comment'] = ('TODO: NOT ONCE in the log that was measured — either this window did not contain '
                         'it, or no rule recognises it (see log_match). The weight below is still the '
                         'placeholder, not a measurement. ' + str(c.get('_comment', '')))
        absent.append(c['name'])

win = mix.get('window') or {}
window = (f"{win['from']} → {win['to']}" if win.get('from') and win.get('to')
          else 'a window the log did not timestamp in any format this tool reads')
unc = mix['unclassified']
gap = ''
if unc['count']:
    gap = (f" ⚠️ {unc['share']*100:.1f}% of the counted requests matched no class at all, so these weights "
           f"describe {(1-unc['share'])*100:.1f}% of the traffic: run `crowdsim weights` on the same log to "
           "see what they were, and declare the classes they belong to.")
profile['_classes_comment'] = (
    f"The MIX, MEASURED: {mix['classified']} of {mix['counted']} GET requests classified over {window}. "
    "Weights are relative; the generator renormalises them. ⚠️ This is your traffic in THAT window — a mix "
    "measured in a quiet hour does not reproduce a spike, because the classes that grow under load are "
    "exactly the ones a quiet window under-weights. Re-measure on the spike you want to replay." + gap)
profile['_provenance'] = list(profile.get('_provenance') or []) + [
    f"an access log of {mix['lines']} lines: {mix['classified']} requests classified into "
    f"{len(measured)} class(es) over {window}"]

json.dump(profile, open(dest, 'w', encoding='utf-8'), indent=1, ensure_ascii=False)

print(f"  ✅ mix measured: {mix['classified']} of {mix['counted']} GET requests classified, "
      f"from {mix['lines']} lines")
for c in mix['classes']:
    mark = '' if c['weight'] else '   ← not once in this log: weight left as the placeholder'
    print(f"     {c['name']:<14} {c['weight']:>6.1f}{mark}")
if unc['count']:
    print(f"  ⚠️  {unc['share']*100:.1f}% unclassified: these weights describe "
          f"{(1-unc['share'])*100:.1f}% of the traffic, not all of it.")
    print(f"      See what did not match:  crowdsim weights <log> --profile {dest}")
print(f"     window: {window}")
print("")
print("  It will NOT run yet, by design:")
print("     · safety.allow_hosts and safety.safe_peak_rps are empty — fill them in;")
print("     · slo.max_p95_ms and slo.guillotine_ms are TODO, and the second must be your proxy's read")
print("       timeout, or the 504s a run produces will be invisible to it.")
print("")
print(f"  Then:  crowdsim validate {dest}")
PYMIX
}

# ───────────────────── `latest` and `previous`, wherever a run id is accepted ────────────────────────
# `crowdsim report latest` used to answer `no summary for latest`, so the only way to report on the run
# that just finished was to read the id out of history and retype sixteen characters — which is also how
# the wrong run gets reported: 20260901T123654Z and 20260901T123645Z are one glance apart.
#
# Two rules make this a convenience rather than a hazard:
#
#  · **the resolution is always printed**, on stderr so it cannot land in a redirected report. A command
#    that silently picks a run is how a result gets attributed to the wrong experiment.
#  · **`latest` skips nothing.** The newest run resolves even when it is a discard (generator_ok: false),
#    and is then reported as the discard it is. Quietly stepping back to the previous run would hand over
#    a valid-looking result for a run nobody asked about.
#
# One resolver, not three: `report`, `compare` and anything added later go through here.
run_ids_newest_first() {
  ls -1 "$OUT_DIR"/summary-*.json 2>/dev/null \
    | sed -e 's|.*/summary-||' -e 's|\.json$||' \
    | sort -r
}

resolve_run_id() {
  local sel="$1"
  case "$sel" in latest|previous) ;; *) printf '%s' "$sel"; return 0;; esac

  local ids; ids="$(run_ids_newest_first)"
  local n; n="$(printf '%s' "$ids" | grep -c . || true)"
  if [ "${n:-0}" -eq 0 ]; then
    die "there are no runs in $OUT_DIR yet, so \`$sel\` resolves to nothing. \`crowdsim history\` lists
  the runs there are." 2
  fi
  if [ "$sel" = "previous" ] && [ "${n:-0}" -lt 2 ]; then
    die "only one run in $OUT_DIR, so there is no \`previous\`. \`crowdsim history\` lists them." 2
  fi

  local want=1
  [ "$sel" = "previous" ] && want=2
  local id; id="$(printf '%s\n' "$ids" | sed -n "${want}p")"
  printf '  ℹ️  %s → %s\n' "$sel" "$id" >&2
  printf '%s' "$id"
}

cmd_report() {
  local run="${POSITIONAL[0]:-}"
  if [ -z "$run" ]; then
    die "report needs a run id: crowdsim report <run-id|latest|previous> (see crowdsim history)" 2
  fi
  run="$(resolve_run_id "$run")"
  if [ -n "${REPORT_COMPARE:-}" ]; then REPORT_COMPARE="$(resolve_run_id "$REPORT_COMPARE")"; fi
  local summary="$OUT_DIR/summary-$run.json"
  if [ ! -f "$summary" ]; then
    die "no summary for $run in $OUT_DIR — is that a run id? (crowdsim history)" 2
  fi

  # ── --html: the same run as a page with charts ──────────────────────────────────────────────────
  # A ramp is a curve, and a table of eight rows asks the reader to draw it in their head. The markdown
  # report stays exactly as it was: it is the right thing for a ticket, and it needs no node.
  if [ "${REPORT_HTML:-0}" = "1" ]; then
    if [ -n "${REPORT_COMPARE:-}" ]; then
      die "--html reports one run. A delta between two runs is \`crowdsim compare\` (and the markdown
  report embeds it with --compare): drawing two runs on one pair of axes without compare's refusals
  would put a confident picture behind two different experiments." 2
    fi
    if ! command -v node >/dev/null 2>&1; then
      die "crowdsim report --html needs node (18+): the charts live in lib/report-html.mjs, where their
  geometry is tested. The markdown report needs nothing: crowdsim report $run" 5
    fi
    local renderer="$ROOT/lib/report-html-cli.mjs"
    [ -f "$renderer" ] || die "missing $renderer (is CROWDSIM_ROOT right?)" 5
    local html_out="${REPORT_OUT:-$OUT_DIR/report-$run.html}"
    node "$renderer" "$summary" --out "$html_out" --version "$(crowdsim_version)"
    say "     open it in a browser, attach it, or print it to PDF — it fetches nothing and renders offline"
    return 0
  fi

  local out="${REPORT_OUT:-$OUT_DIR/report-$run.md}"
  local compare_block=""
  if [ -n "${REPORT_COMPARE:-}" ]; then
    # The delta comes from the command that owns that judgement, refusals included. Recomputing it here
    # would be a second opinion, and the first time the two disagreed the wrong one would be in a document.
    local cmp_rc=0 cmp_out
    cmp_out="$("$0" compare "$run" "$REPORT_COMPARE" 2>&1)" || cmp_rc=$?
    compare_block="$OUT_DIR/.report-cmp-$run.txt"
    {
      printf '## Compared with %s\n\n' "$REPORT_COMPARE"
      if [ "$cmp_rc" != "0" ]; then
        printf 'crowdsim compare **refused this comparison**, and that refusal is the answer:\n\n'
      else
        printf 'From `crowdsim compare %s %s` — the same verdict a terminal prints:\n\n' \
          "$run" "$REPORT_COMPARE"
      fi
      printf '```\n%s\n```\n\n' "$cmp_out"
    } > "$compare_block"
  fi

  python3 - "$summary" "$out" "${compare_block:-}" <<'PY'
import json, os, sys

summary_path, out_path, compare_block = sys.argv[1], sys.argv[2], sys.argv[3]
d = json.load(open(summary_path, encoding='utf-8'))

def ms(v):
    return 'n/a' if v is None else (f'{v:.2f} ms' if abs(v) < 10 else f'{v:.0f} ms')

def pct(v):
    return 'n/a' if v is None else f'{v * 100:.2f}%'

L = []
w = L.append
w(f"# crowdsim run {d.get('run_id')}")
w('')
w(f"- **profile** `{d.get('profile')}` · **target** `{d.get('base_url')}` · **shape** "
  f"`{d.get('shape')}` · **requested peak** {d.get('peak_rps_user_target')} user req/s")
if d.get('warmup'):
    w(f"- **warm-up** {d['warmup']}, excluded from every number below")
w('')

# 1. Is the run valid at all? Nothing below means anything until this is answered — docs/reading-results.md
#    exists because the failure mode of a load test is a plausible number, not a crash.
w('## Is this run valid?')
w('')
if d.get('generator_ok') is False:
    w('**DISCARD THIS RUN.** The summary says `generator_ok: false`: more than 2% of iterations were '
      'dropped, so the generator or its network was the bottleneck — not the system under test. A '
      'generator-bound run looks exactly like a healthy system absorbing load, which is why no numbers '
      'from it are reproduced here.')
    w('')
    w(f"- {d.get('dropped_iterations', 0)} iterations dropped out of {d.get('requests', 0)} requests")
    w('- Move the generator closer to the target, or onto a bigger host, and run it again.')
    w('')
    w('---')
    w('')
    w('_This report describes your infrastructure: it names your hosts. Keep it wherever your run '
      'archives already belong._')
    open(out_path, 'w', encoding='utf-8').write('\n'.join(L) + '\n')
    print(f'  ✅ report: {out_path}')
    raise SystemExit(0)

if d.get('target_unreachable'):
    w('**This is a connectivity result, not a capacity one.** The target never answered, so the numbers '
      'below describe a failed connection. Run `crowdsim probe` against the same target before trying '
      'again.')
else:
    w(f"Yes. The generator held the requested rate ({d.get('dropped_iterations', 0)} dropped iterations "
      f"of {d.get('requests', 0)} requests), and the target answered.")
w('')

# 2. Did the brake trip? An abort is the intended outcome, and the exit code is 0 for that reason.
w('## What happened')
w('')
if d.get('aborted'):
    by = d.get('aborted_by') or {}
    who = by.get('class')
    detail = ''
    if by.get('threshold'):
        reached = by.get('value')
        detail = (f" — `{by['threshold']}`"
                  + (f", reached {reached:.0f}" if isinstance(reached, (int, float)) else ''))
    w(f"The brake aborted the run: **you found the knee**, which is what this tool is for. It is not a "
      f"failure of the run or of the tool.")
    if who:
        w('')
        w(f"Stopped by class **{who}**{detail}.")
    elif detail:
        w('')
        w(f"Stopped by the run's overall threshold{detail}.")
else:
    w('The run completed without crossing its thresholds: the brake did not trip at this peak.')
w('')

# 3. The margin: the share past the proxy read timeout is where 504s come from.
if d.get('over_guillotine_rate') is not None and d.get('guillotine_ms') is not None:
    w(f"**Past the {d['guillotine_ms']} ms read timeout:** {pct(d['over_guillotine_rate'])} of requests. "
      'That share, not the average latency, is the margin you actually have — past it a real visitor gets '
      'a 504.')
    w('')

# 3b. The knee: the claim this whole run exists to support, and the one that will be quoted without its
# caveats unless they are attached to it here. Absent for a run archived before per-step numbers existed —
# inventing a refusal reason for those would be a statement about a run that never had the data.
knee = d.get('knee')
if knee:
    w('## The knee')
    w('')
    if knee.get('refused'):
        w(f"**No knee from this run.** {knee['reason']}")
        w('')
        w(f"{knee['fix']}")
        w('')
        w('This is not "no knee found": it is a run that cannot answer the question. Quoting the requested '
          'peak instead would quote the one rate nobody measured this system surviving.')
    else:
        w(f"**{knee['summary'][0].upper()}{knee['summary'][1:]}**")
        w('')
        clean = knee.get('clean') or {}
        if clean.get('caveat'):
            w(f"- {clean['caveat'][0].upper()}{clean['caveat'][1:]}. A rate the ramp passed through is not "
              'a rate the system was held at: only the `--hold` step holds one.')
        crossed = knee.get('crossed') or {}
        if crossed.get('partial'):
            w('- The step that crossed is **partial** — the run ended inside it — so it says where the '
              'system broke, not how it behaves at that rate.')
        w('- This is a knee **at this URL pool**. A synthetic pool of distinct cold URLs is a harder test '
          'than the traffic your visitors produce, so the real knee is at or above this rate, not below it.')
    w('')

# 4. Only now, the numbers.
w('## Numbers')
w('')
w('| metric | value |')
w('|---|---|')
dur = d.get('dur') or {}
for label, key in (('p50', 'p50'), ('p95', 'p95'), ('p99', 'p99'), ('max', 'max')):
    if dur.get(key) is not None:
        w(f'| {label} | {ms(dur[key])} |')
if d.get('failed_rate') is not None:
    w(f"| failed rate | {pct(d['failed_rate'])} |")
for label, key in (('504', 'e504'), ('502', 'e502'), ('5xx total', 'e5xx'), ('404', 'e404')):
    if d.get(key) is not None:
        w(f'| {label} | {d[key]} |')
w(f"| requests | {d.get('requests', 0)} |")
if d.get('rps_avg') is not None:
    w(f"| achieved rate | {d['rps_avg']:.1f} req/s |")
w('')

cache = d.get('cache') or {}
if cache:
    w('### Cache hit ratio per layer')
    w('')
    for layer in cache:
        v = cache[layer]
        if v is None:
            w(f'- **{layer}**: n/a — the declared header never appeared in any response, so nothing was '
              'classified. That is usually the wrong header name in the profile rather than a cold cache, '
              'and it is never a 0% hit ratio.')
        else:
            w(f'- **{layer}**: {pct(v)}')
    w('')

per_class = d.get('per_class') or {}
if per_class:
    w('### Per class')
    w('')
    w('| class | requests | p95 | p99 | failed |')
    w('|---|---|---|---|---|')
    for name in per_class:
        c = per_class[name] or {}
        w(f"| {name} | {c.get('reqs', 0)} | {ms(c.get('p95'))} | {ms(c.get('p99'))} "
          f"| {pct(c.get('failed'))} |")
    w('')

if compare_block and os.path.exists(compare_block):
    w(open(compare_block, encoding='utf-8').read().rstrip('\n'))
    w('')

# 5. The caveats, in the document rather than in somebody's memory.
w('## What these numbers are worth')
w('')
w('- **Only the delta travels.** These absolutes describe this URL pool, which is colder than real '
  'traffic: a synthetic pool of cold URLs is a harder test than the mix your visitors produce. Quote the '
  'change between two runs at an identical pool, not the number.')
w('- **The mix is the measurement.** `--peak` is total user req/s split across the profile\'s request '
  'classes by the weights measured on your own edge log, not page loads.')
# Concurrent users: the unit a capacity requirement is written in. Two numbers or a refusal, never one.
conc = d.get('concurrency')
if conc:
    w('## Concurrent users')
    w('')
    if conc.get('refused'):
        w(f"**No concurrency figure from this run.** {conc['reason']} {conc.get('fix', '')}")
    else:
        w(f"- **{conc.get('derived')}** derived: {conc.get('sessions_per_sec') and round(conc['sessions_per_sec'], 1)} "
          f"sessions/s x {conc.get('mean_session_seconds') and round(conc['mean_session_seconds'], 1)} s mean "
          "session (Little's law)")
        w(f"- **{conc.get('observed')}** counted in flight: the peak number of sessions running at once")
        if conc.get('agree') is True:
            w('- The two methods **agree**, which is what makes the number worth quoting: one alone cannot '
              'tell a measurement from an artefact of the arithmetic.')
        elif conc.get('note'):
            w(f"- ⛔ **They do not agree.** {conc['note']}")
        if conc.get('caveat'):
            w('')
            w(conc['caveat'])
    w('')

auth = d.get('auth') or {}
if auth.get('sharing_note'):
    # A login ceiling measured with 50 accounts across 400 VUs is partly a statement about 50 accounts.
    w(f"- **The accounts were shared.** {auth['sharing_note']}")
elif auth.get('users'):
    w(f"- **{auth['users']} account(s) signed in**, one per virtual user or better, so the sign-in "
      'numbers describe the provider rather than the account count.')
sign = d.get('signup') or {}
if sign.get('created'):
    w(f"- **This run created {sign['created']} accounts on the target, and they still exist.** crowdsim "
      "will not delete them: removing accounts from an identity provider is not a load generator's job. "
      f"Find them with `{sign.get('email_glob')}`, listed in `signups-{d.get('run_id')}.json` next to "
      "this summary. That file names real accounts on a real system — do not commit it.")
think = d.get('think_time') or {}
if think.get('source'):
    w(f"- **The reading pauses were {think['source']}** ({think.get('min_ms')}-{think.get('max_ms')} ms). "
      'Session duration is the fan-out plus these pauses, so any concurrency figure rests on them.')
if d.get('dropped_iterations'):
    w(f"- **{d['dropped_iterations']} iterations were dropped** out of {d.get('requests', 0)}. Under the 2% "
      'threshold, so the run stands — but it is the number to watch if you raise the peak.')
w('')
w('---')
w('')
w('_This report describes your infrastructure: it names your hosts. Keep it wherever your run archives '
  'already belong._')

open(out_path, 'w', encoding='utf-8').write('\n'.join(L) + '\n')
print(f'  ✅ report: {out_path}')
PY
  rm -f "$OUT_DIR/.report-cmp-$run.txt"
}

cmd_compare() {
  local a="${POSITIONAL[0]:-}" b="${POSITIONAL[1]:-}"
  if [ -z "$a" ] || [ -z "$b" ]; then
    die "compare needs two run ids: crowdsim compare <run-a|latest|previous> <run-b> (see crowdsim history)" 2
  fi
  # Resolved BEFORE anything else, and every refusal compare already has still applies to the result: a
  # resolved id is checked for a matching pool, profile and generator_ok exactly like a typed one.
  a="$(resolve_run_id "$a")"; b="$(resolve_run_id "$b")"
  local rc=0
  python3 - "$OUT_DIR" "$a" "$b" "${COMPARE_JSON:-0}" <<'PY' || rc=$?
import json, os, sys

out_dir, a_id, b_id, as_json = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4] == '1'

# The comparison is COMPUTED once into a structure, and then either printed as prose or dumped as JSON.
# That split is the whole reason --json exists: the GUI shows the same verdict as this command because it
# asks this command, instead of carrying a second copy of the rules — which would drift, and then disagree
# on screen, while somebody is deciding something.

def fail(msg):
    """A usage-level problem: not a refusal to compare, but nothing to compare."""
    if as_json:
        json.dump({'error': msg}, sys.stdout, indent=1)
        print()
    else:
        print(f'  ❌ {msg}')
    raise SystemExit(2)

def load(run_id, what):
    path = os.path.join(out_dir, f'{what}-{run_id}.json')
    try:
        return json.load(open(path, encoding='utf-8'))
    except FileNotFoundError:
        return None
    except Exception as e:
        fail(f'{path} does not parse: {e}')

runs = {}
for run_id in (a_id, b_id):
    s = load(run_id, 'summary')
    if s is None:
        fail(f'no summary for {run_id} in {out_dir} — is that a run id? (crowdsim history)')
    runs[run_id] = s

A, B = runs[a_id], runs[b_id]
refusals = []
notes = []
warnings = []

# out/ is long-lived: it holds runs written by whichever version was installed at the time, and `history`
# lists them all. A summary from before a field existed must produce a refusal like any other pair that
# cannot be compared — the alternative was a Python traceback and exit 1, which is not in the exit-code
# contract the schedulers, the bats suite and the GUI all read.
NEEDED = ('dur', 'failed_rate', 'generator_ok')
for run_id in (a_id, b_id):
    missing = [k for k in NEEDED if runs[run_id].get(k) is None]
    if missing:
        refusals.append((
            f'{run_id} has no {", ".join(missing)}: it was written by an older crowdsim than this one',
            ['Compare two runs from the same tool version, or re-run the older one. A summary missing the '
             'fields a comparison reads has nothing to compare.']))

# 1. A run the generator could not deliver has no numbers to compare. Checked first because it is the one
#    that looks most like a valid result.
for r in (a_id, b_id):
    if runs[r].get('generator_ok') is False:
        refusals.append((f'{r} has generator_ok: false — the generator, not the target, was the bottleneck',
                         ['Move the generator closer to the target and run it again; nothing in that run '
                          'is measurable.']))
    if runs[r].get('target_unreachable'):
        refusals.append((f'{r} never reached its target', ['That is connectivity, not capacity.']))

# 2. Different pools mean two different experiments. The resolved profile of each run has the pools inlined,
#    which is exactly why it is archived.
pa, pb = load(a_id, 'profile'), load(b_id, 'profile')
if pa is None or pb is None:
    warnings.append('one of the runs has no resolved profile archived, so the URL pools could not be '
                    'compared. Runs from 1.0.0 onwards write profile-<run>.json; older ones do not.')
else:
    ka, kb = pa.get('pools') or {}, pb.get('pools') or {}
    if set(ka) != set(kb):
        refusals.append((f'different pool names: {sorted(set(ka))} vs {sorted(set(kb))}', []))
    else:
        differing = [k for k in ka if ka[k] != kb.get(k)]
        if differing:
            refusals.append((
                '; '.join(f'pool "{k}" is not the same list of URLs in both runs '
                          f'({len(ka[k])} vs {len(kb.get(k) or [])} entries)' for k in differing),
                ['Numbers are comparable only between runs at an identical pool: a colder pool is a harder '
                 'test.']))

if A.get('shape') != B.get('shape'):
    refusals.append((f'different shapes: {A.get("shape")} vs {B.get("shape")} — a journey and a mix are not '
                     'the same load', []))

# 3. Same pool, different target or different peak is a legitimate question — but it changes what the delta
#    MEANS, so it is stated rather than assumed.
if A.get('base_url') != B.get('base_url'):
    notes.append(f'different targets ({A.get("base_url")} → {B.get("base_url")}): this is a comparison '
                 'BETWEEN TWO TARGETS, not a before/after of one')
if A.get('profile') != B.get('profile'):
    notes.append(f'different profiles ({A.get("profile")} → {B.get("profile")})')
if A.get('peak_rps_user_target') != B.get('peak_rps_user_target'):
    notes.append(f'different peaks ({A.get("peak_rps_user_target")} → {B.get("peak_rps_user_target")} '
                 'req/s): latency at different rates is a different question')
for r in (a_id, b_id):
    if runs[r].get('aborted'):
        notes.append(f'{r} was aborted by the brake: its numbers describe the moment the SLO was crossed')

def head(s, run_id):
    return {'run_id': run_id, 'profile': s.get('profile'), 'base_url': s.get('base_url'),
            'shape': s.get('shape'), 'peak': s.get('peak_rps_user_target'),
            'aborted': bool(s.get('aborted')), 'generator_ok': s.get('generator_ok'),
            'requests': s.get('requests')}

def row(label, av, bv, unit, lower_is_better=True):
    """One comparable pair. `change` is None when either side has nothing to compare."""
    d = None if av is None or bv is None else bv - av
    rel = None if not d or not av else d / av
    if d is None:
        verdict = 'unknown'
    elif abs(d) < 1e-9:
        verdict = 'same'
    else:
        verdict = 'better' if (d < 0) == lower_is_better else 'worse'
    return {'label': label, 'unit': unit, 'a': av, 'b': bv, 'change': d, 'relative': rel,
            'verdict': verdict}

result = {
    'a': head(A, a_id),
    'b': head(B, b_id),
    'refused': [{'reason': r, 'detail': d} for r, d in refusals],
    'notes': notes,
    'warnings': warnings,
}

if not refusals:
    result['overall'] = [
        row('p50', A['dur'].get('p50'), B['dur'].get('p50'), 'ms'),
        row('p95', A['dur'].get('p95'), B['dur'].get('p95'), 'ms'),
        row('p99', A['dur'].get('p99'), B['dur'].get('p99'), 'ms'),
        row('failed rate', A.get('failed_rate'), B.get('failed_rate'), 'ratio'),
        row(f'over {A.get("guillotine_ms")} ms', A.get('over_guillotine_rate'),
            B.get('over_guillotine_rate'), 'ratio'),
        row('504s', A.get('e504', 0), B.get('e504', 0), 'count'),
        row('requests', A.get('requests', 0), B.get('requests', 0), 'count', lower_is_better=False),
    ]
    # Cache hit ratio per layer. None means the header never appeared: n/a, never 0%.
    layers = list(A.get('cache') or {})
    for k in (B.get('cache') or {}):
        if k not in layers:
            layers.append(k)
    result['layers'] = [row(layer, (A.get('cache') or {}).get(layer), (B.get('cache') or {}).get(layer),
                            'ratio', lower_is_better=False) for layer in layers]

    classes = list(A.get('per_class') or {})
    for c in (B.get('per_class') or {}):
        if c not in classes:
            classes.append(c)
    per_class = []
    for c in classes:
        ca = (A.get('per_class') or {}).get(c) or {}
        cb = (B.get('per_class') or {}).get(c) or {}
        if not ca or not cb:
            per_class.append({'class': c, 'only_in': 'a' if ca else 'b'})
            continue
        per_class.append({
            'class': c, 'only_in': None,
            'p95': row('p95', ca.get('p95'), cb.get('p95'), 'ms'),
            'failed': row('failed', ca.get('failed'), cb.get('failed'), 'ratio'),
        })
    result['per_class'] = per_class

if as_json:
    json.dump(result, sys.stdout, indent=1)
    print()
    raise SystemExit(2 if refusals else 0)

# ── prose, rendered from exactly that structure ─────────────────────────────────────────────────────
if refusals:
    print('  ⛔ refusing to compare these two runs:')
    for r, detail in refusals:
        print(f'     {r}')
        for line in detail:
            print(f'     {line}')
    print('     A comparison that is not like-for-like is a confident number with nothing behind it.')
    raise SystemExit(2)

def fmt(v, unit):
    if v is None:
        return '—'
    if unit == 'ms':
        # A tenth of a millisecond matters on a loopback target and is noise on a real one, so the precision
        # follows the number: "0 ms → 0 ms (+67%)" reads like a broken calculation.
        return f'{v:.2f} ms' if abs(v) < 10 else f'{v:.0f} ms'
    if unit == 'ratio':
        return f'{v * 100:.2f}%'
    return f'{v:g}'

def change(r):
    if r['change'] is None:
        return '—'
    d, unit = r['change'], r['unit']
    if unit == 'ms':
        shown = f'{d:+.2f} ms' if abs(d) < 10 else f'{d:+.0f} ms'
    elif unit == 'ratio':
        shown = f'{d * 100:+.2f} pp'
    else:
        shown = f'{d:+.0f}'
    rel = f' ({r["relative"] * 100:+.0f}%)' if r['relative'] else ''
    mark = {'better': ' ✅', 'worse': ' ⚠️', 'same': '  =', 'unknown': ''}[r['verdict']]
    return f'{shown}{rel}{mark}'

for w in warnings:
    print(f'  ⚠️  {w}')
print()
for k in ('a', 'b'):
    h = result[k]
    print(f'  {k.upper()}  {h["run_id"]}   profile {h["profile"]}  {h["base_url"]}  '
          f'shape {h["shape"]}  peak {h["peak"]}')
if notes:
    print()
    for n in notes:
        print(f'  ℹ️  {n}')

print()
print('  ── overall ─────────────────────────────────────────────────────────────────────')
print(f'  {"":<18}{"A":>12}{"B":>12}   change')
for r in result['overall']:
    if r['label'] == 'requests':
        print(f'  {r["label"]:<18}{fmt(r["a"], r["unit"]):>12}{fmt(r["b"], r["unit"]):>12}')
        continue
    print(f'  {r["label"]:<18}{fmt(r["a"], r["unit"]):>12}{fmt(r["b"], r["unit"]):>12}   {change(r)}')

if result['layers']:
    print()
    print('  ── cache hit ratio per layer ───────────────────────────────────────────────────')
    print(f'  {"":<18}{"A":>12}{"B":>12}   change')
    for r in result['layers']:
        if r['a'] is None and r['b'] is None:
            print(f'  {r["label"]:<18}{"n/a":>12}{"n/a":>12}   header never appeared in either run')
            continue
        print(f'  {r["label"]:<18}{fmt(r["a"], r["unit"]):>12}{fmt(r["b"], r["unit"]):>12}   {change(r)}')

if result['per_class']:
    print()
    print('  ── per class ───────────────────────────────────────────────────────────────────')
    print(f'  {"class":<14}{"p95 A":>10}{"p95 B":>10}{"change":>18}{"failed A":>10}{"failed B":>10}')
    for c in result['per_class']:
        if c['only_in']:
            print(f'  {c["class"]:<14}  present only in run {c["only_in"].upper()} '
                  '(a class was skipped, or the profile changed)')
            continue
        p95, failed = c['p95'], c['failed']
        print(f'  {c["class"]:<14}{fmt(p95["a"], "ms"):>10}{fmt(p95["b"], "ms"):>10}'
              f'{change(p95):>18}{fmt(failed["a"], "ratio"):>10}{fmt(failed["b"], "ratio"):>10}')

print()
print('  Deltas are the honest part. The absolutes above describe this pool, which is colder than real')
print('  traffic — quote the change, not the number.')
PY
  if [ "$rc" != "0" ]; then exit "$rc"; fi
}

# ─────────────────────────────── record: a journey from a browser recording ──────────────────────────
# `--shape journey` reproduces a visitor session — one document plus the fan-out the browser performs — and
# it needs a file of {path, rsc[], static[]} per page. The instruction used to be "record it with a real
# browser", with no way to turn that recording into the file, so the mode went unused and the mix shape
# carried load nobody clicks.
#
# A HAR export is that recording. The judgements it takes (drop third-party hosts, strip per-request cache
# busters but keep build hashes, do not record failures) live in lib/har.mjs with unit tests, because each of
# them is a way to end up measuring something other than your site.
cmd_record() {
  local har="${POSITIONAL[0]:-}"
  if [ -z "$har" ]; then
    die "record needs a HAR file: crowdsim record <file.har> [--out <journey.json>]" 2
  fi
  if [ ! -f "$har" ]; then die "no such file: $har" 2; fi
  if ! command -v node >/dev/null 2>&1; then
    die "crowdsim record needs node (18+): the HAR rules live in lib/har.mjs, where they are tested" 5
  fi
  local recorder="$ROOT/lib/record-cli.mjs"
  if [ ! -f "$recorder" ]; then die "missing $recorder (is CROWDSIM_ROOT right?)" 5; fi

  # Default destination: next to the run output, which is gitignored. A journey names real routes on a real
  # site — the same category as a URL pool — so it must not land in profiles/ by default or by accident.
  local out="${JOURNEY_OUT:-$OUT_DIR/journey-$RUN_ID.json}"
  mkdir -p "$OUT_DIR"
  say "▶ reading $har"
  local -a args=("$recorder" "$har" --out "$out" --profiles-dir "${CROWDSIM_PROFILES:-$ROOT/profiles}")
  if [ -n "${RECORD_ORIGIN:-}" ]; then args+=(--origin "$RECORD_ORIGIN"); fi
  if [ -n "${RSC_QUERY_OVERRIDE:-}" ]; then args+=(--rsc-query "$RSC_QUERY_OVERRIDE"); fi
  if [ "${FORCE_OVERWRITE:-0}" = "1" ]; then args+=(--force); fi
  exec node "${args[@]}"
}

notify_slack() {
  local hook="${CROWDSIM_SLACK_WEBHOOK:-}"
  if [ -z "$hook" ]; then warn "--slack given but CROWDSIM_SLACK_WEBHOOK is unset"; return 0; fi
  python3 - "$1" "$hook" <<'PY'
import json, sys, urllib.request
d = json.load(open(sys.argv[1]))
pct = lambda x: 'n/a' if x is None else f'{x*100:.2f}%'
head = '⛔ aborted by the brake' if d['aborted'] else '✅ completed'
if not d.get('generator_ok'): head = '⚠️ INVALID (generator did not hold the rate)'
txt = (f"*crowdsim — {d.get('profile')} — run {d['run_id']}*  {head}\n"
       f"target `{d['base_url']}` · shape {d['shape']} · requested peak {d['peak_rps_user_target']} req/s\n"
       f"{d['requests']} requests · {d['rps_avg']:.1f} req/s · failed {pct(d['failed_rate'])} · "
       f"p95 {round(d['dur']['p95'] or 0)} ms · 504 {d['e504']} · 502 {d['e502']}")
req = urllib.request.Request(sys.argv[2], data=json.dumps({'text': txt}).encode(),
                             headers={'Content-Type': 'application/json'})
try:
    urllib.request.urlopen(req, timeout=10).read()
    print('  ✅ slack recap sent')
except Exception as e:
    print(f'  ⚠️  slack recap failed: {e}')
PY
}

# ─────────────────────────────── cache-ab ───────────────────────────────────────────────────────────
# The warning every candidate-style template must carry. A third leg is normally a copy of the candidate,
# and the copy is exactly where a warning gets dropped — so it is checked rather than trusted.
AB_WARNING='READ THIS BEFORE COPYING IT TO PRODUCTION'

# Scaffold a new leg from the candidate, so the warning travels by construction instead of by discipline.
cache_ab_new_leg() {
  local dest="$1"
  local src="$ROOT/cache-ab/candidate.conf.template"
  [ -f "$src" ] || die "missing $src (is CROWDSIM_ROOT right?)" 5
  [ ! -e "$dest" ] || die "$dest already exists — a leg you have already written is not ours to replace" 2
  local leg; leg="$(basename "$dest" | sed -E 's/\.conf\.template$//; s/\.template$//; s/\.conf$//')"
  case "$leg" in
    asis|candidate|'') die "pick a name that is not 'asis' or 'candidate': the leg name is how the two are
  told apart in the results (X-AB-Leg)" 2;;
  esac
  mkdir -p "$(dirname "$dest")"
  # Built in a temporary file and only then moved into place: a leg that fails its own checks must not be
  # left on disk for somebody to find and use.
  local tmp="$dest.tmp.$$"
  # The directive is indented inside the server block, so the pattern must not anchor at column 0 — it did
  # once, silently produced a leg still calling itself "candidate", and the check below caught it.
  sed -E "s/^([[:space:]]*add_header[[:space:]]+X-AB-Leg[[:space:]]+)\"candidate\"/\1\"$leg\"/" "$src" > "$tmp"
  if ! grep -q "$AB_WARNING" "$tmp"; then
    rm -f "$tmp"; die "the scaffolded leg lost its warning — refusing to write it" 2
  fi
  if ! grep -qE "X-AB-Leg[[:space:]]+\"$leg\"" "$tmp"; then
    rm -f "$tmp"
    die "the scaffolded leg is still named \"candidate\" in X-AB-Leg — refusing to write a leg that
  cannot be told apart from the one it was copied from" 2
  fi
  mv "$tmp" "$dest"
  ok "wrote $dest (leg \"$leg\", copied from candidate.conf.template with its warning intact)"
  say "  Edit it down to the narrow subset you can actually ship, then:"
  say "      crowdsim cache-ab --profile <p.json> --third $dest"
  exit 0
}

# Load each leg and print the delta, instead of printing the commands and hoping.
#
# The whole reason for two legs is the number between them, and until now the command stopped one step
# short: it brought the legs up, printed two `crowdsim load` lines, and left the comparison to whoever
# remembered to make it. `crowdsim compare` exists now, refusals and all.
#
# Sequential, not concurrent. Two generators at once on one host measure the host — and the delta they
# produce is between two runs that were both throttled by the same laptop, which is a number about the
# laptop. The cost is that "same window" means "same session, minutes apart" rather than "same second";
# that is stated in the output rather than glossed over.
# The legs live on loopback, so the runs against them need 127.0.0.1 allowlisted — and this command does
# NOT grant it. No default allowlist, anywhere, for anyone: the moment a subcommand can authorise a host on
# your behalf, the gate is a suggestion. It is one line in the profile, and it is checked here, before any
# container starts, instead of surfacing as an exit 3 from a child process three screens later.
cache_ab_require_loopback_allowed() {
  local allow="${CROWDSIM_ALLOW_TARGETS:-$(pf safety.allow_hosts | tr -d '[]"' | tr -d ' ')}"
  local m=0 pat
  IFS=',' read -r -a _pats <<< "$allow"
  for pat in "${_pats[@]}"; do
    case "127.0.0.1" in $pat) m=1;; esac
  done
  if [ "$m" != "1" ]; then
    die "--run loads the legs on 127.0.0.1, and that host is not allowlisted (${allow:-nothing is}).

  Add it where the rest of this test's configuration lives:
      \"safety\": { \"allow_hosts\": [\"127.0.0.1\", …] }
  or for this shell: CROWDSIM_ALLOW_TARGETS=127.0.0.1

  crowdsim grants no allowlist to itself, not even for containers it started a second ago." 3
  fi
}

cache_ab_run_legs() {
  local third_abs="$1"
  local -a legs=("asis:8081" "candidate:8082")
  if [ -n "$third_abs" ]; then legs+=("third:8083"); fi

  say ""
  say "▶ loading each leg in turn, same profile, same pool, same peak (${PEAK} req/s)"
  say "  sequential on purpose: two generators at once on this host would measure this host."

  local -a ids=() names=()
  local leg name port rc out id
  for leg in "${legs[@]}"; do
    name="${leg%%:*}"; port="${leg##*:}"
    say ""
    say "── leg $name (http://127.0.0.1:$port) ──────────────────────────────────────────"
    rc=0
    # The driver runs itself: one load path, one set of gates, one summary format. A second inlined copy of
    # the run logic here would be a second thing to keep correct.
    out="$("$0" load --profile "$PROFILE_F" --base-url "http://127.0.0.1:$port" \
             --peak "$PEAK" --start "$START" --steps "$STEPS" --step-dur "$STEP_DUR" --hold "$HOLD" \
             2>&1)" || rc=$?
    printf '%s\n' "$out" | tail -24
    if [ "$rc" != "0" ]; then
      die "leg $name exited $rc — stopping here rather than comparing against a run that did not happen" "$rc"
    fi
    id="$(printf '%s\n' "$out" | sed -nE 's/^[[:space:]]*run[[:space:]]+([0-9]{8}T[0-9]{6}Z)[[:space:]]*$/\1/p' | head -1)"
    if [ -z "$id" ]; then
      die "leg $name produced no run id, so there is nothing to compare" 4
    fi
    ids+=("$id"); names+=("$name")
  done

  say ""
  say "╔══════════════════════════════════════════════════════════════════════════════╗"
  say "║  cache-ab: the delta between the legs"
  say "╚══════════════════════════════════════════════════════════════════════════════╝"
  say "  Every leg saw the same pool at the same peak, minutes apart — not the same second. A cache is"
  say "  warmed by the traffic before it, so a leg that ran second had the same cold start as the first,"
  say "  but the ORIGIN behind them did not: read a small delta with that in mind."

  local i
  for i in $(seq 1 $(( ${#ids[@]} - 1 ))); do
    say ""
    say "── ${names[0]} → ${names[$i]} ──────────────────────────────────────────────────────"
    # Refusals are compare's, not ours: if these two runs are not comparable it says so and exits 2, and
    # that is the honest end of this command too.
    "$0" compare "${ids[0]}" "${ids[$i]}" || true
  done
  say ""
  say "  then:  cd $ROOT/cache-ab && docker compose ${third_abs:+--profile third }down"
}

cmd_cache_ab() {
  if [ -n "${NEW_LEG:-}" ]; then cache_ab_new_leg "$NEW_LEG"; fi
  need_profile; resolve_profile; resolve_target; gate_allowlist
  if ! command -v docker >/dev/null 2>&1; then die "cache-ab needs docker" 5; fi

  # The third leg, if asked for. Two checks, both about the result being readable afterwards rather than
  # about nginx starting: a template without the warning is a copy that lost the one paragraph explaining
  # what ignoring Cache-Control costs, and a template still calling itself "candidate" makes two legs
  # indistinguishable in the very header the comparison is read from.
  if [ "${RUN_LEGS:-0}" = "1" ]; then cache_ab_require_loopback_allowed; fi

  local -a compose_profile=()
  local third_abs=""
  if [ -n "${THIRD_LEG:-}" ]; then
    [ -f "$THIRD_LEG" ] || die "no such leg template: $THIRD_LEG (create one with: crowdsim cache-ab --new-leg <file>)" 2
    third_abs="$(cd "$(dirname "$THIRD_LEG")" && pwd)/$(basename "$THIRD_LEG")"
    if ! grep -q "$AB_WARNING" "$third_abs"; then
      die "$THIRD_LEG does not carry the candidate template's warning about ignoring the origin's
  Cache-Control. That paragraph is the difference between a measurement and an outage: copy it across
  unchanged, or start from 'crowdsim cache-ab --new-leg <file>'" 2
    fi
    local leg_name; leg_name="$(sed -nE 's/^[[:space:]]*add_header X-AB-Leg[[:space:]]+"([^"]+)".*/\1/p' "$third_abs" | head -1)"
    case "$leg_name" in
      ''|asis|candidate)
        die "the third leg still identifies itself as \"${leg_name:-unset}\" in X-AB-Leg. Give it its own
  name, or its responses cannot be told from the other legs in the results" 2;;
    esac
    compose_profile=(--profile third)
  fi
  local origin_host="${HOST_HEADER:-$(printf '%s' "$BASE_URL" | sed -E 's#^[a-z]+://##; s#[:/].*$##')}"
  local origin_addr; origin_addr="${BYPASS#*=}"
  if [ -z "$origin_addr" ]; then origin_addr="$origin_host"; fi
  say "▶ cache-ab: two nginx legs against $origin_host ($origin_addr), TTL ${TTL}s"
  say "  see cache-ab/README.md — the legs are yours to edit; the point is comparing YOUR candidate"
  say "  config against as-is on the same origin, at the same time, with the same pool."
  if [ -n "$third_abs" ]; then say "  third leg: $third_abs"; fi
  ( cd "$ROOT/cache-ab" && ORIGIN_ADDR="$origin_addr" ORIGIN_HOST="$origin_host" CACHE_TTL="$TTL" \
      THIRD_TEMPLATE="$third_abs" docker compose "${compose_profile[@]}" up -d --force-recreate )
  if [ "${RUN_LEGS:-0}" = "1" ]; then cache_ab_run_legs "$third_abs"; return 0; fi


  say ""
  say "  legs up. Now run the load against each and compare:"
  say "      crowdsim load --profile $PROFILE_F --base-url http://127.0.0.1:8081 --peak $PEAK   # as-is"
  say "      crowdsim load --profile $PROFILE_F --base-url http://127.0.0.1:8082 --peak $PEAK   # candidate"
  if [ -n "$third_abs" ]; then
    say "      crowdsim load --profile $PROFILE_F --base-url http://127.0.0.1:8083 --peak $PEAK   # third"
  fi
  say "  same pool, same window — then: crowdsim compare <run-a> <run-b>"
  if [ -n "$third_abs" ]; then
    say "  then:  cd $ROOT/cache-ab && docker compose --profile third down"
  else
    say "  then:  cd $ROOT/cache-ab && docker compose down"
  fi
}

# ─────────────────────────────── serve (GUI) ────────────────────────────────────────────────────────
# The GUI is a form over this script: every run it starts is a child process of `crowdsim load`, with the
# same gates and the same output directory. It adds no way to bypass anything — and it deliberately binds
# loopback only, because a page that can generate 500 req/s at your production is not a page to leave
# open on a shared network (the server refuses another bind address without CROWDSIM_GUI_TOKEN).
cmd_serve() {
  if ! command -v node >/dev/null 2>&1; then
    die "the GUI needs node (18+). The CLI does not: everything the GUI can do is available as a
  subcommand here. Install node, or keep using 'crowdsim load'." 5
  fi
  if [ ! -f "$ROOT/gui/server/node_modules/express/package.json" ] \
     && [ ! -f "$ROOT/node_modules/express/package.json" ]; then
    die "GUI dependencies are missing: run 'npm install' in $ROOT" 5
  fi
  if [ ! -d "$ROOT/gui/ui/dist" ]; then
    warn "the UI is not built — the API will answer, the page will not. Run: npm run gui:build"
  fi
  export CROWDSIM_OUT="$OUT_DIR"
  export CROWDSIM_PROFILES="${CROWDSIM_PROFILES:-$ROOT/profiles}"
  # THE driver the GUI must spawn is THIS one: the script that was just invoked. Everything the server can
  # do otherwise is a search — $CROWDSIM_ROOT, its own checkout, PATH — and a search can find a different
  # copy from the one somebody chose to run. It also closes the gap that shipped in the image for eleven
  # releases, where the server looked next to itself (/crowdsim/bin/crowdsim) for a driver that lives in
  # /usr/local/bin. An explicit CROWDSIM_BIN from the caller still wins.
  export CROWDSIM_BIN="${CROWDSIM_BIN:-$SELF_DIR/$(basename "$0")}"
  if [ -n "$GUI_PORT" ]; then export CROWDSIM_GUI_PORT="$GUI_PORT"; fi
  if [ -n "$GUI_BIND" ]; then export CROWDSIM_GUI_BIND="$GUI_BIND"; fi
  exec node "$ROOT/gui/server/index.js"
}

case "$CMD" in
  doctor)   cmd_doctor;;
  discover) cmd_discover;;
  probe)    resolve_profile; cmd_probe;;
  load)     cmd_load;;
  cache-ab) cmd_cache_ab;;
  history)  cmd_history;;
  compare)  cmd_compare;;
  report)   cmd_report;;
  weights)  cmd_weights;;
  init)     cmd_init;;
  record)   cmd_record;;
  validate) cmd_validate;;
  serve)    cmd_serve;;
  *)        die "unknown subcommand: $CMD (try --help)" 2;;
esac
