#!/usr/bin/env bash
# A stand-in for bin/crowdsim, so the GUI suite can assert on decisions without generating load.
#
#   FAKE_EXIT         exit code to return (default 0) — used to check exit codes are passed through
#   FAKE_SLEEP        stay alive this long, to test concurrency and graceful stop
#   FAKE_SUMMARY_SRC  copy this file into $CROWDSIM_OUT as the run summary
set -eo pipefail

trap 'echo "interrupted: winding down and keeping the summary"; exit 0' INT

echo "ARGV: $*"
echo "  run       20260805T101112Z"

# `report <run-id>` writes a markdown file where the real one does, so the API test can assert that the
# server hands over the CLI's artefact instead of rendering its own.
if [ "${1:-}" = "report" ]; then
  if [ "${FAKE_EXIT:-0}" != "0" ]; then
    echo "no summary for ${2:-}" >&2
    exit "${FAKE_EXIT}"
  fi
  mkdir -p "$CROWDSIM_OUT"
  # --html writes a different file, exactly as the real driver does: the endpoint must pick the right one
  # rather than serving whichever happens to exist.
  case "$*" in
    *--html*)
      printf '<!doctype html>\n<title>crowdsim %s</title>\n<p>FAKE HTML REPORT BODY</p>\n' "${2:-}" \
        > "$CROWDSIM_OUT/report-${2:-unknown}.html"
      echo "  ✅ wrote $CROWDSIM_OUT/report-${2:-}.html"
      exit 0;;
  esac
  printf '# crowdsim %s\n\n## Is this run valid?\n\nFAKE REPORT BODY\n' "${2:-}" \
    > "$CROWDSIM_OUT/report-${2:-unknown}.md"
  echo "  ✅ wrote $CROWDSIM_OUT/report-${2:-}.md"
  exit 0
fi

# `history --html --out <file>` and `compare a b --html` write pages where the real driver does, so the
# API tests can assert the server hands over the CLI's artefact instead of rendering its own. The argv is
# echoed into the page so a test can see which filters reached the driver.
if [ "${1:-}" = "history" ]; then
  case "$*" in
    *--html*)
      out=""
      prev=""
      for a in "$@"; do
        if [ "$prev" = "--out" ]; then out="$a"; fi
        prev="$a"
      done
      [ -n "$out" ] || { echo "no --out given" >&2; exit 2; }
      printf '<!doctype html>\n<title>trend</title>\n<p>FAKE TREND PAGE</p>\n<pre>%s</pre>\n' "$*" > "$out"
      exit 0;;
  esac
fi

if [ "${1:-}" = "compare" ]; then
  case "$*" in
    *--html*)
      if [ "${FAKE_EXIT:-0}" != "0" ]; then
        echo "different pool names: these two runs are not the same experiment" >&2
        exit "${FAKE_EXIT}"
      fi
      mkdir -p "$CROWDSIM_OUT"
      printf '<!doctype html>\n<title>delta</title>\n<p>FAKE COMPARE PAGE</p>\n' \
        > "$CROWDSIM_OUT/compare-${2:-a}-${3:-b}.html"
      exit 0;;
  esac
fi

if [ -n "${FAKE_SUMMARY_SRC:-}" ]; then
  mkdir -p "$CROWDSIM_OUT"
  cp "$FAKE_SUMMARY_SRC" "$CROWDSIM_OUT/summary-20260805T101112Z.json"
  echo "  ✅ summary: $CROWDSIM_OUT/summary-20260805T101112Z.json"
fi

if [ -n "${FAKE_SLEEP:-}" ]; then sleep "$FAKE_SLEEP"; fi
exit "${FAKE_EXIT:-0}"
