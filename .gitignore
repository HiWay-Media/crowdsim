# Run output: summaries, logs, resolved profiles, history.
out/

# ⚠️ Your own profiles and URL pools are a map of your infrastructure — hostnames, internal addresses,
#    real routes, build hashes. They do not belong in a public repo. Keep them in a private one.
profiles/*.json
!profiles/example.json
pool-*.json
journey*.json
!profiles/journey.example.json

# Local cache-ab overrides
cache-ab/docker-compose.override.yml
cache-ab/*.local.template

.DS_Store

# graphify knowledge graph (generated)
graphify-out/

# GUI toolchain and build output
node_modules/
gui/ui/dist/

# End-to-end suite scratch (container logs, summaries from the local target)
tests/e2e/.out/

# Local compose environment: token, hostnames.
.env

# Documentation site built by mkdocs (published by .github/workflows/pages.yml)
site/
.venv-docs/

# Python bytecode: the docs build imports scripts/mkdocs_hooks.py, which leaves a
# __pycache__ next to it.
__pycache__/
*.pyc
