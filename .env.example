# Copy to .env for `docker compose up`. .env is gitignored: it holds a token and your hostnames.

# Required. The GUI refuses to start without it, because in a container it cannot bind loopback and so
# cannot know how narrowly you published the port.
#   openssl rand -hex 16
CROWDSIM_GUI_TOKEN=

# The hosts crowdsim may generate load against, comma separated, globs allowed. There is no default
# anywhere in this project: a load test aimed at the wrong hostname is indistinguishable from an attack.
# Leave empty to rely on each profile's own safety.allow_hosts.
#   CROWDSIM_ALLOW_TARGETS=www.example.test,10.0.0.*
CROWDSIM_ALLOW_TARGETS=

# Optional: use a locally built image (make image) instead of the published one.
#   CROWDSIM_IMAGE=crowdsim:dev
#CROWDSIM_IMAGE=

# Optional: a Slack webhook for run recaps (`--slack`). A secret — it belongs here, not in a committed file.
#CROWDSIM_SLACK_WEBHOOK=
